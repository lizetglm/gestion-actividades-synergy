{
  "_version": "1.48.0",
  "sap.app": {
    "id": "ns.frontend",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.32.0",
      "toolsId": "be6f0b9d-8e77-4f22-9bd7-b0ab56d789ef"
    },
    "dataSources": {
      "ZUI_DBVIEW_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZUI_DBVIEW_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZUI_DBVIEW_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZUI_DBVIEW/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZUI_DBVIEW_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ns.frontend.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "ns.frontend.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteRegistrarActividad",
          "pattern": "registrar",
          "target": [
            "TargetRegistrarActividad"
          ]
        },
        {
          "name": "RouteCalendarioActividades",
          "pattern": "calendario",
          "target": [
            "TargetCalendarioActividades"
          ]
        },
        {
          "name": "RoutePanelCumplimiento",
          "pattern": "panelCumplimiento",
          "target": [
            "TargetPanelCumplimiento"
          ]
        },
        {
          "name": "RouteClientesProyectos",
          "pattern": "clientesProyectos",
          "target": [
            "TargetClientesProyectos"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Main",
          "viewName": "Main"
        },
        "TargetRegistrarActividad": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "RegistrarActividad",
          "viewName": "RegistrarActividad"
        },
        "TargetCalendarioActividades": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "CalendarioActividades",
          "viewName": "CalendarioActividades"
        },
        "TargetPanelCumplimiento": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "PanelCumplimiento",
          "viewName": "admin.PanelCumplimiento"
        },
        "TargetClientesProyectos": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "ClientesProyectos",
          "viewName": "admin.ClientesProyectos"
        }
      }
    },
    "rootView": {
      "viewName": "ns.frontend.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}
