{
  "_version": "1.48.0",
  "sap.app": {
    "id": "ns.frontend",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.32.0",
      "toolsId": "be6f0b9d-8e77-4f22-9bd7-b0ab56d789ef"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zgl_sb_gestion/srvd/sap/zgl_sd_gestion/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/mainService/metadata.xml"
        }
      },
      "actividadesService": {
        "uri": "/sap/opu/odata4/sap/zgl_sb_gestion/srvd/sap/zgl_sd_gestion/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    } 
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
        
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ns.frontend.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "updateGroupId": "grupoDialogo"
        }
      },
      "actividadesOData": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "actividadesService",
        "preload": false,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "ns.frontend.view",
        "controlAggregation": "pages",
        "controlId": "mainContents",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteRegistrarActividad",
          "pattern": "registrar",
          "target": [
            "TargetRegistrarActividad"
          ]
        },
        {
          "name": "RouteCalendarioActividades",
          "pattern": "calendario",
          "target": [
            "TargetCalendarioActividades"
          ]
        },
        {
          "name": "RouteReporteMensual",
          "pattern": "reporteMensual",
          "target": [
            "TargetReporteMensual"
          ]
        },
        {
          "name": "RouteHistorial",
          "pattern": "historial",
          "target": [
            "TargetHistorial"
          ]
        },
        {
          "name": "RouteConsolidacion",
          "pattern": "consolidacion",
          "target": [
            "TargetConsolidacion"
          ]
        },
        {
          "name": "RoutePanelCumplimiento",
          "pattern": "panelCumplimiento",
          "target": [
            "TargetPanelCumplimiento"
          ]
        },
        {
    "name": "RouteClientesProyectos",
      "pattern": "clientesProyectos",
      "target": ["TargetClientesProyectos", "TargetClientesMaster"]
    },
        {
          "name": "RouteProyectos",
          "pattern": "clientesProyectos/cliente/{clientUuid}",
          "target": ["TargetClientesProyectos", "TargetClientesMaster", "TargetProyectosDetalle"]
        },
        {
          "name": "RouteRequerimientos",
          "pattern": "clientesProyectos/cliente/{clientUuid}/proyecto/{projectUuid}",
          "target": ["TargetClientesProyectos", "TargetClientesMaster", "TargetProyectosDetalle", "TargetRequerimientosDetalle"]
        },
        {
          "name": "RoutePerfiles",
          "pattern": "perfiles",
          "target": [
            "TargetPerfiles"
          ]
        },
        {
          "name": "RouteConfiguracion",
          "pattern": "configuracion",
          "target": [
            "TargetConfiguracion"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Main",
          "viewName": "Main"
        },
        "TargetRegistrarActividad": {
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "RegistrarActividad",
          "viewName": "RegistrarActividad"
        },
        "TargetCalendarioActividades": {
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "CalendarioActividades",
          "viewName": "CalendarioActividades"
        },
        "TargetReporteMensual": {
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "ReporteMensual",
          "viewName": "ReporteMensual"
        },
        "TargetHistorial": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Historial",
          "viewName": "Historial"
        },
         "TargetConsolidacion": {
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Consolidacion",
          "viewName": "Consolidacion"
        },
        "TargetPanelCumplimiento": {
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "PanelCumplimiento",
          "viewName": "admin.PanelCumplimiento"
        },
        "TargetClientesProyectos": {
          "viewType": "XML",
          "transition": "slide",
          "viewId": "ClientesProyectos",
          "viewName": "admin.ClientesProyectos" 
        },
        "TargetClientesMaster": {
          "parent": "TargetClientesProyectos",
          "controlId": "fcl",
          "controlAggregation": "beginColumnPages",
          "viewId": "Clientes",
          "viewName": "admin.Clientes" 
        },
        "TargetProyectosDetalle": {
          "parent": "TargetClientesProyectos",
          "controlId": "fcl",
          "controlAggregation": "midColumnPages",
          "viewId": "Proyectos",
          "viewName": "admin.Proyectos" 
        },
        "TargetRequerimientosDetalle": {
          "parent": "TargetClientesProyectos",
          "controlId": "fcl",
          "controlAggregation": "endColumnPages",
          "viewId": "Requerimientos",
          "viewName": "admin.Requerimientos" 
        },
        "TargetPerfiles": {
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Perfiles",
          "viewName": "admin.Perfiles"
        },
        "TargetConfiguracion": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Configuracion",
          "viewName": "admin.Configuracion"
        }
      }
    },
    "rootView": {
      "viewName": "ns.frontend.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}


