<mvc:View controllerName="ns.frontend.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="idMainPage"  showHeader="false">
        <!-- <customHeader >
            <core:Fragment fragmentName="ns.frontend.fragment.Header" />
        </customHeader> -->

        <content>
            <VBox class="sapUiMediumMargin">
                <Title
                    level="H2" titleStyle="H2"
                    text="{uiPantalla>/saludo}"
                    wrapping="true"
                    wrappingType="Hyphenated"
                >
                </Title>

                <!-- APLICACIONES DE CONSULTOR -->
                <VBox class="sapUiSmallMarginTopBottom  ">
                    <Label
                        design="Bold"
                        text="{i18n>consultantGroup}"
                        vAlign="Middle"
                        wrapping="true" wrappingType="Hyphenated"
                    />
                    <FlexBox id="idFlexBox"  wrap="Wrap" 
                        class="contendorApps" items="{apps>/listaConsultor}"
                    >
                        <GenericTile 
                            class="sapUiTinyMarginTop tileLayout" 
                            header="{apps>titulo}" 
                            subheader="" 
                            press=".onNavegarApp">
                            <TileContent footer="{apps>descripcion}">
                                <ImageContent src="{apps>icono}" />
                            </TileContent>
                        </GenericTile>
                    </FlexBox>
                </VBox>

                <!-- APLICACIONES DE ADMINISTRADOR -->
                <VBox class="sapUiSmallMarginTopBottom  ">
                    <Label
                        design="Bold"
                        text="{i18n>adminGroup}"
                        vAlign="Middle"
                        wrapping="true" wrappingType="Hyphenated"
                    />
                    <FlexBox id="idFlexBox2"  wrap="Wrap" 
                        class="contendorApps" items="{apps>/listaAdmin}"
                    >
                        <GenericTile 
                            class="sapUiTinyMarginTop tileLayout" 
                            header="{apps>titulo}" 
                            press=".onNavegarApp">
                            <TileContent  footer="{apps>descripcion}">
                                <ImageContent src="{apps>icono}" />
                            </TileContent>
                        </GenericTile>
                    </FlexBox>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
