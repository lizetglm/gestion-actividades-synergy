
<mvc:View
    id="vistaReporteMensual"
    controllerName="ns.frontend.controller.ReporteMensual"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    busyIndicatorDelay="0"
    height="100%"
    displayBlock="true">

    <Page
        id="reportPage"
        showHeader="false"
        enableScrolling="true"
        backgroundDesign="Transparent"
        class="sapUiResponsiveContentPadding">

        <content>
            <VBox
                id="idBannerRM"
                class="sapUiSmallMargin gapBody">

                <Breadcrumbs
                    id="idActualDireccionRM"
                    currentLocationText="{i18n>repTitle}">

                    <Link
                        id="idRegresoRM"
                        text="{i18n>title}"
                        press=".onBack"/>
                </Breadcrumbs>

                <FlexBox
                    id="idFlexBoxRM"
                    justifyContent="SpaceBetween"
                    alignItems="End">

                    <Title
                        id="idTituloRM"
                        level="H4"
                        titleStyle="H4"
                        text="Mi Reporte Mensual"
                        wrapping="true"
                        wrappingType="Hyphenated"/>

                    <HBox
                        id="statusBox1"
                        alignItems="Center">

                        <Label
                            id="lblStatusTe1xt"
                            text="Estatus: "
                            class="sapUiTinyMarginEnd boldLabel"/>

                        <ObjectStatus
                            id="objS1tatus"
                            text="{reporteSeleccionado>/EstadoTexto}"
                            state="{reporteSeleccionado>/EstadoColor}"/>
                    </HBox>
                </FlexBox>

                <HBox
                    id="mainLayout"
                    justifyContent="SpaceBetween"
                    wrap="Wrap">

                    <VBox
                        id="leftColumn"
                        width="69%">

                        <Panel
                            id="panelReporte"
                            backgroundDesign="Solid"
                            headerText="REPORTE MENSUAL DE ACTIVIDADES DE CONSULTORÍA"
                            accessibleRole="Region"
                            class="borde">

                            <content>
                                <Text
                                    id="txtConsultorInfo"
                                    text="{reporteSeleccionado>/InformacionConsultor}"
                                    class="sapUiSmallMarginBottom"/>                                
                                <Table
                                    id="activityTable"
                                    class="sapUiTinyMarginBottom borde"
                                    noDataText="No hay actividades registradas durante el mes actual."
                                    items="{reporteSeleccionado>/Actividades}">

                                    <columns>
                                        <Column>
                                            <Text text="Fecha"/>
                                        </Column>

                                        <Column>
                                            <Text text="Cliente"/>
                                        </Column>

                                        <Column>
                                            <Text text="Proyecto"/>
                                        </Column>

                                        <Column>
                                            <Text text="Requerimiento"/>
                                        </Column>

                                        <Column>
                                            <Text text="Descripción"/>
                                        </Column>

                                        <Column hAlign="End">
                                            <Text text="Horas"/>
                                        </Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{reporteSeleccionado>FechaTexto}"/>
                                                <Text text="{reporteSeleccionado>Cliente}"/>
                                                <Text text="{reporteSeleccionado>Proyecto}"/>
                                                <Text text="{reporteSeleccionado>Requerimiento}"/>
                                                <Text text="{reporteSeleccionado>Descripcion}"/>
                                                <Text text="{reporteSeleccionado>HorasTexto}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>


                                <Toolbar
                                    id="toolbarTotales"
                                    class="sapUiSmallMarginBottom toolbarTotalesCustom">

                                    <content>
                                        <Label
                                            id="lblTotales"
                                            text="{reporteSeleccionado>/TotalHorasTexto}"
                                            class="totalHorasText"/>
                                    </content>
                                </Toolbar>

                                <Text
                                    id="lblDeclaracion"
                                    text="Al firmar declaro que la información anterior refleja fielmente las actividades realizadas durante el periodo."
                                    class="sapUiTinyMarginBottom textoGrisSuave"/>

                                <VBox
                                    id="boxFirma"
                                    class="sapUiSmallMarginTop textoGrisSuave">

                                    <Label
                                        id="lblFirma"
                                        text="Firma electrónica: ________________________________________________"
                                        class="sapUiSmallMarginBottom"/>

                                    <Label
                                        id="lblFechaFirma"
                                        text="Fecha de firma: Pendiente"/>
                                </VBox>
                            </content>
                        </Panel>
                    </VBox>

                    <VBox
                        id="rightColumn"
                        width="29%">

                        <Panel
                            id="panelAccionesGlobal"
                            backgroundDesign="Solid"
                            headerText="Acciones"
                            class="borde">

                            <content>
                                <Panel id="panelAcciones">
                                    <content>
                                        <Button
                                            id="btnPDF"
                                            text="Descargar PDF"
                                            width="100%"
                                            class="sapUiTinyMarginBottom"
                                            icon="sap-icon://pdf-attachment"
                                            enabled="{reporteSeleccionado>/TienePDF}"
                                            press=".onDownloadPDF"/>

                                        <Button
                                            id="btnFirmar"
                                            text="Firmar y enviar a RR.HH."
                                            width="100%"
                                            type="Emphasized"
                                            class="sapUiTinyMarginBottom"
                                            enabled="{reporteSeleccionado>/PuedeFirmar}"
                                            press=".onSignReport"/>

                                        <Button
                                            id="btnReapertura"
                                            text="Solicitar reapertura del periodo"
                                            width="100%"
                                            type="Reject"
                                            enabled="{reporteSeleccionado>/PuedeSolicitarReapertura}"
                                            press=".onRequestReopen"/>
                                    </content>
                                </Panel>

                                <Panel
                                    id="panelHistorial"
                                    backgroundDesign="Translucent"
                                    headerText="Historial de estatus">

                                    <content>
                                        <List
                                            id="historialList"
                                            showSeparators="None"
                                            noDataText="No existe historial registrado."
                                            items="{reporteSeleccionado>/Historial}">

                                            <StandardListItem
                                                title="{reporteSeleccionado>Texto}"/>
                                        </List>
                                    </content>
                                </Panel>
                            </content>
                        </Panel>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>

