<mvc:View id="viewConsolidacion"
    controllerName="ns.frontend.controller.Consolidacion"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout" 
    xmlns:f="sap.f"
    xmlns="sap.m"
    busyIndicatorDelay="0"
    height="100%"
    displayBlock="true"
>
    <!-- DynamicPage es el estándar actual para Fiori 3 Worklists -->
    <f:DynamicPage id="pageConsolidacion" class="sapUiSizeCompact" showFooter="true">
        
        <f:title>
            <f:DynamicPageTitle>
                <f:breadcrumbs >
                   <Breadcrumbs currentLocationText="{i18n>appAdmin5}"
                    class="sapUiSmallMarginTopBottom">
                        <Link text="{i18n>tituloGrupo1}" press=".onBack" />
                    </Breadcrumbs>
                </f:breadcrumbs>
                <f:heading>
                    <Title text="Consolidación Mensual de Reportes" level="H2" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <layout:HorizontalLayout allowWrapping="true">
                    <layout:VerticalLayout class="sapUiMediumMarginEnd">
                        <Label text="Periodo" labelFor="periodComboBox"/>
                        <ComboBox id="periodComboBox" selectedKey="{filterModel>/period}" width="150px">
                            <core:Item key="All" text="Todos"/>
                            <core:Item key="Sep2026" text="Septiembre 2026"/>
                            <core:Item key="Oct2026" text="Octubre 2026"/>
                        </ComboBox>
                    </layout:VerticalLayout>

                    <layout:VerticalLayout class="sapUiMediumMarginEnd">
                        <Label text="Estatus de Consolidación" labelFor="statusComboBox"/>
                        <ComboBox id="statusComboBox" selectedKey="{filterModel>/status}" width="180px">
                            <core:Item key="All" text="Todos"/>
                            <core:Item key="Ready" text="Listo para envío"/>
                            <core:Item key="Draft" text="Pendiente firmas"/>
                        </ComboBox>
                    </layout:VerticalLayout>

                    <layout:VerticalLayout class="sapUiMediumMarginEnd">
                        <Label text="Cliente / Área" labelFor="areaComboBox"/>
                        <ComboBox id="areaComboBox" selectedKey="{filterModel>/period}" width="150px">
                            <core:Item key="All" text="Todos"/>
                            <core:Item key="Alpha" text="Alpha S.A. de C.V."/>
                            <core:Item key="Beta" text="Beta Tech Solutions"/>
                            <core:Item key="Gamma" text="Gamma Logistics"/>
                        </ComboBox>
                    </layout:VerticalLayout>

                    <layout:VerticalLayout class="sapUiSmallMarginBegin">
                        <Label text="" /> 
                        <Button text="Ir" type="Emphasized" press=".onExecuteFilter"/>
                    </layout:VerticalLayout>
                </layout:HorizontalLayout>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table id="consolidacionTable"
                items="{
                    path: 'consolidacionModel>/reports',
                    sorter: [
                        { path: 'Month' },
                        { path: 'StatusState', descending: false },
                        { path: 'Cliente', descending: false }
                    ]
                }"
                mode="MultiSelect"
                selectionChange=".onSelectionChange"
                alternateRowColors="true"
                class="sapUiSmallMarginBottom">
                
                <headerToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://sort" tooltip="Ordenar" press=".onAbrirOrdenamiento" />
                        <Button icon="sap-icon://excel-attachment" tooltip="{i18n>btnExportarExcel}" press=".onExportarExcel" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Cliente / Proyecto"/>
                    </Column>
                    <Column width="10rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Periodo" />
                    </Column>
                    <Column hAlign="Center" width="10rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Headcount" tooltip="Consultores"/>
                    </Column>
                    <Column hAlign="Center" width="10rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Total Horas" />
                    </Column>
                    <Column hAlign="Center" width="15rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Estatus de Envío"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem vAlign="Middle" type="Navigation" press=".onVerDetallePaquete">
                        <cells>
                            <VBox>
                                <Text text="{consolidacionModel>Cliente}" class="sapUiTinyMarginBottom"/>
                                <Text text="{consolidacionModel>Proyecto}" />
                            </VBox>
                            <Text text="{consolidacionModel>Month}"/>
                            <HBox justifyContent="Center" alignItems="Center" gap="0.3rem">
                                <core:Icon src="sap-icon://employee" color="Neutral"/>
                                <Text text="{consolidacionModel>Headcount}" />
                            </HBox>
                            <ObjectNumber number="{consolidacionModel>TotalHours}" unit="hrs"/>
                            <ObjectStatus 
                                text="{consolidacionModel>StatusText}" 
                                state="{consolidacionModel>StatusState}" 
                                
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <Text id="mensajeFooterText" text="Selecciona los paquetes consolidados a enviar." class="sapUiSmallMarginBegin"/>
                <ToolbarSpacer />
                <Button id="btnGuardarBorrador" text="Guardar Borrador" type="Transparent" press=".onSaveDraft" />
                <Button id="btnCancelarConsolidacion" text="Deseleccionar" type="Reject" press=".onCancel" />
                <Button id="btnEnviarAprobacion" text="Enviar al Cliente" type="Emphasized" icon="sap-icon://paper-plane" press=".onSendForApproval" />
            </OverflowToolbar>
        </f:footer>

    </f:DynamicPage>
</mvc:View>