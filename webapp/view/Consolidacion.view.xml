<mvc:View
    id="viewConsolidacion"
    controllerName="com.cg.actividades.vistacalendarioactividades.controller.Consolidacion"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout" 
	xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    busyIndicatorDelay="0"
    height="100%"
    displayBlock="true"
>
    <Page
        id="pageConsolidacion"
        showHeader="false"
        backgroundDesign="Transparent"
        class="sapUiResponsiveContentPadding"
        
        enableScrolling="true"
>
        <content>

            <VBox id="idBanner" class="sapUiSmallMargin gapBody">
                <Breadcrumbs id="idActualDireccion" currentLocationText="{i18n>consolidacionTitle}">
                    <Link id="idRegreso" text="{i18n>title}" press=".onBack" />
                </Breadcrumbs>

                <FlexBox id="idFlexBox" justifyContent="SpaceBetween" alignItems="End" >
                    <Title
                        id="idTitulo"
                        level="H4" titleStyle="H4"
                        text="Consolidación Mensual de Reportes"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                    <Button 
                        id="btnConfiguracionConsolidacion"
                        text="Configuración" 
                        icon="sap-icon://action-settings" 
                        type="Transparent"
                        press=".onSettings"    
                    />
                </FlexBox>

                <!-- Filtros de búsqueda de paquetes-->
                
<!-- Filtros de búsqueda de paquetes -->
<HBox
    id="filtersConsolidacion"
    class="filters sapUiResponsiveContentPadding"
    alignItems="Center"
    wrap="Wrap">

    <!-- Filtro de periodo -->
    <HBox
        id="filterFieldPeriodo"
        class="filterField"
        alignItems="Center">

        <Label
            id="labelPeriodo"
            text="Periodo"
            labelFor="periodComboBox"/>

        <ComboBox
            id="periodComboBox"
            selectedKey="{filterModel>/period}"
            width="10rem">

            <core:Item id="items213" key="All" text="Todos"/>
            <core:Item id="items7" key="Aug2026" text="Agosto 2026"/>
            <core:Item id="items8"  key="Sep2026" text="Septiembre 2026"/>

        </ComboBox>
    </HBox>

    <!-- Filtro de estatus -->
    <HBox
        id="filterFieldEstatus"
        class="filterField"
        alignItems="Center">

        <Label
            id="labelEstatusConsolidacion"
            text="Estatus de consolidación"
            labelFor="statusComboBox"/>

        <ComboBox
            id="statusComboBox"
            selectedKey="{filterModel>/status}"
            width="12rem">

            <core:Item id="items4" key="All" text="Todos"/>
            <core:Item id="items5" key="Ready" text="Listo para aprobación"/>
            <core:Item id="items6" key="Draft" text="Borrador"/>

        </ComboBox>
    </HBox>

    <!-- Filtro de agrupación -->
    <HBox
        id="filterFieldAgrupacion"
        class="filterField"
        alignItems="Center">

        <Label
            id="labelAgruparPor"
            text="Agrupar por"
            labelFor="groupByComboBox"/>

        <ComboBox
            id="groupByComboBox"
            selectedKey="{filterModel>/groupBy}"
            width="10rem">

            <core:Item id="items1" key="Department" text="Departamento"/>
            <core:Item id="items2" key="Month" text="Mes"/>
            <core:Item id="items3" key="Status" text="Estatus"/>

        </ComboBox>
    </HBox>

    <!-- Botón de búsqueda -->
    <Button
        id="executeFilterButton"
        text="Go"
        type="Emphasized"
        press="onExecuteFilter"
        class="goButton"/>

</HBox>


            
            
            
            <VBox
                id="consolidationLayout"
                class="consolidationLayout">

            
                    <Table
                        id="consolidacionTable"
                        items="{consolidacionModel>/reports}"
                        mode="MultiSelect"
                        selectionChange="onSelectionChange"
                        includeItemInSelection="true"
                        growing="true"
                        growingScrollToLoad="true"
                        class="">

                        <columns>
                            <Column id="columnMesDepartamento" width="28%">
                                <Text
                                    id="headerMesDepartamento"
                                    text="Mes / Departamento"/>
                            </Column>

                            <Column id="columnConsolidacionID" width="18%">
                                <Text
                                    id="headerConsolidacionID"
                                    text="Consolidación ID"/>
                            </Column>

                            <Column
                                id="columnHeadcount"
                                width="16%"
                                hAlign="End">

                                <Text
                                    id="headerHeadcount"
                                    text="Headcount"/>
                            </Column>

                            <Column
                                id="columnTotalHoras"
                                width="18%"
                                hAlign="End">

                                <Text
                                    id="headerTotalHoras"
                                    text="Total horas"/>
                            </Column>

                            <Column id="columnEstatusEnvio" width="20%">
                                <Text
                                    id="headerEstatusEnvio"
                                    text="Estatus de envío"/>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem
                                id="templateFilaConsolidacion"
                                vAlign="Middle">

                                <cells>
                                    <VBox id="cellMesDepartamento">
                                        <Text
                                            id="cellMesReporte"
                                            text="{consolidacionModel>Month}"
                                            class="reportMonth"/>

                                        <Text
                                            id="cellDepartamentoReporte"
                                            text="{consolidacionModel>Department}"
                                            class="reportDepartment"/>
                                    </VBox>

                                    <Text
                                        id="cellConsolidacionID"
                                        text="{consolidacionModel>ConsolidacionID}"/>

                                    <Text
                                        id="cellHeadcount"
                                        text="{consolidacionModel>Headcount}"/>

                                    <Text
                                        id="cellTotalHoras"
                                        text="{consolidacionModel>TotalHours}"
                                        class="totalHorasText"/>

                                    <ObjectStatus
                                        id="cellEstatusEnvio"
                                        text="{consolidacionModel>StatusText}"
                                        state="{consolidacionModel>StatusState}"
                                        inverted="true"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <!-- Barra inferior de acciones -->
                <HBox
                    id="bottomActionsConsolidacion"
                    class="borde bottomBar textAcciones"
                    alignItems="Center">

                    <Text
                        id="selectedRowsText"
                        class="textAcciones"
                        text="Selecciona los reportes que deseas procesar."/>

                    <ToolbarSpacer id="spacerAccionesInferiores"/>

                    <Button
                        id="btnEnviarAprobacion"
                        text="Enviar a aprobación"
                        type="Emphasized"
                        icon="sap-icon://paper-plane"
                        press="onSave"
                        />

                    <Button
                        id="btnGuardarBorrador"
                        text="Guardar borrador"
                        press="onSaveDraft"
                        class="btnGuardar"/>

                    <Button
                        id="btnCancelarConsolidacion"
                        text="Cancelar"
                        type="Reject"
                        press="onCancel"
                        class="btnCancelar"/>
                                    
                        
                </HBox>

                </VBox>
        </content>
    </Page>
</mvc:View>
