                                <HBox id="id42" alignItems="Center" wrap="Wrap">
                                    <Button
                                        id="id52"
                                        text="Ver Reporte"
                                        icon="sap-icon://search"
                                        type="Transparent"
                                        tooltip="Ver reporte"
                                        class="accionHistorial"/>
