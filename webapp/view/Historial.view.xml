                        <ColumnListItem id="reporteFebrero2026" vAlign="Middle">
                            <cells>
                                <Text id="id19" text="Febrero 2026"/>
                                <Text id="id20" text="Cliente Alpha S.A."/>
                                <Text id="id21" text="165.5 h"/>

                                <ObjectStatus
