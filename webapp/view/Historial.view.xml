                                    state="Success"
                                    icon="sap-icon://status-positive"/>

                                <HBox id="id47" alignItems="Center" wrap="Wrap">
                                    <Button
                                        id="id57"
                                        text="Descargar PDF"
                                        icon="sap-icon://download"
                                        type="Transparent"
                                        tooltip="Descargar PDF"
                                        class="accionHistorial"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>

                        <ColumnListItem id="reporteEnero2026" vAlign="Middle">
                            <cells>
                                <Text id="id22" text="Enero 2026"/>
