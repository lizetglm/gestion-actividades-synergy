<mvc:View id="viewHistorial"
	controllerName="ns.frontend.controller.Historial"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    busyIndicatorDelay="0"
    height="100%"
    displayBlock="true"
>
    <Page
        id="pageHistorial"
        showHeader="false"
        enableScrolling="true"
        backgroundDesign="Transparent"
        class="sapUiResponsiveContentPadding"
        >
        <content>
            <VBox id="idBannerHs" class="sapUiSmallMargin gapBody">
                <Breadcrumbs id="idActualDireccionHs" currentLocationText="{i18n>historialTitle}">
                    <Link id="idRegresoHs" text="{i18n>title}" press=".onBack" />
                </Breadcrumbs>

                <FlexBox id="idFlexBoxHs" justifyContent="SpaceBetween" alignItems="End" >
                    <Title
                        id="idTituloHs"
                        level="H4" titleStyle="H4"
                        text="Historial de Reportes Mensuales"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                    <Button 
                        id="btnConfiguracionConsolidacionHs"
                        text="Configuración" 
                        icon="sap-icon://action-settings" 
                        type="Transparent"
                        press=".onSettings"    
                    />
                </FlexBox>

                    
                    <HBox
                        id="filtersHistorial"
                        class="filters sapUiResponsiveContentPadding"
                        alignItems="Center"
                        wrap="Wrap">

                        <HBox
                                                id="filtroClienteContainer"
                                                class="filtersField" alignItems="Center">

                                                <Label
                                                    id="labelFiltroCliente"
                                                    text="Cliente"
                                                    labelFor="filtroCliente"/>

                                                <ComboBox
                                                    id="filtroCliente"
                                                    width="10rem"
                                                    selectedKey="TODOS">
                                                    <items>
                                                        <core:Item id="t9odos" key="TODOS" text="Todos"/>
                                                        <core:Item id="todos1" key="ALPHA" text="Cliente Alpha"/>
                                                        <core:Item id="todos32" key="BETA" text="Cliente Beta"/>
                                                        <core:Item id="todos213" key="GAMMA" text="Cliente Gamma"/>
                                                        <core:Item id="todos2" key="DELTA" text="Cliente Delta"/>
                                                        <core:Item id="todos22" key="INTERNA" text="Consultora Interna"/>
                                                    </items>
                                                </ComboBox>
                                                
                                            </HBox>

                        
                        <HBox id="filtroAnioContainer" class="filtersField" alignItems="Center">
                                                <Label
                                                    id="labelFiltroAnio"
                                                    text="Año"
                                                    labelFor="filtroAnio"/>

                                                <ComboBox
                                                    id="filtroAnio"
                                                    width="10rem"
                                                    selectedKey="2026">
                                                    <items>
                                                        <core:Item id="todos11" key="2026" text="2026"/>
                                                        <core:Item id="todos3123" key="2025" text="2025"/>
                                                        <core:Item id="todo1s" key="2024" text="2024"/>
                                                    </items>
                                                </ComboBox>
                                            </HBox>

                        <Button
                            id="executeFilterButtosn"
                            text="Go"
                            type="Emphasized"
                            press="onExecuteFilter"
                            class="goButton"/>

                    </HBox>



            
                <Table
                    id="tablaHistorialReportes"
                    width="100%"
                    inset="false"
                    growing="true"
                    growingScrollToLoad="false"
                    growingThreshold="10"
                    alternateRowColors="false"
                    showSeparators="All"
                    class="">

                    <columns>
                        <Column
                            id="colPeriodo"
                            width="10rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text id="to23dos" text="Periodo (Mes/Año)"/>
                        </Column>

                        <Column
                            id="colClientePrincipal"
                            width="12rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text id="to34356dos" text="Cliente Principal"/>
                        </Column>

                        <Column
                            id="colTotalHoras"
                            width="11rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text id="to919dos" text="Total Horas"/>
                        </Column>

                        <Column
                            id="colEstatusAprobacion"
                            width="19rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text id="to134dos" text="Estatus de Aprobación"/>
                        </Column>

                        <Column
                            id="colAccionesDescargar"
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text id="to120dos" text="Acciones / Descargar"/>
                        </Column>
                    </columns>

                    <items>

                        <ColumnListItem id="reporteAgosto2026" vAlign="Middle">
                            <cells>
                                <Text id="id1" text="Agosto 2026"/>
                                <Text id="id2" text="Cliente Alpha S.A."/>
                                <Text id="id3" text="168.0 h"/>

                                <ObjectStatus
                                    id="id31"
                                    text="Generado, pendiente de firma"
                                    state="Warning"
                                    icon="sap-icon://alert"/>

                                <HBox id="id41" alignItems="Center" wrap="Wrap">
                                    <Button
                                        id="id51"
                                        text="Ver Reporte"
                                        icon="sap-icon://search"
                                        type="Transparent"
                                        tooltip="Ver reporte"
                                        class="accionHistorial"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>

                        <ColumnListItem id="reporteJulio2026" vAlign="Middle">
                            <cells>
