                                <HBox id="id43" alignItems="Center" wrap="Wrap">
                                    <Button
                                        id="id53"
                                        text="Descargar PDF"
                                        icon="sap-icon://download"
                                        type="Transparent"
                                        tooltip="Descargar PDF"
                                        class="accionHistorial"/>
                                </HBox>
