                                <HBox id="id48" alignItems="Center" wrap="Wrap">
                                    <Button
                                        id="id58"
                                        text="Descargar PDF"
                                        icon="sap-icon://download"
                                        type="Transparent"
                                        tooltip="Descargar PDF"
                                        class="accionHistorial"/>

                                    <Button
                                        id="id59"
