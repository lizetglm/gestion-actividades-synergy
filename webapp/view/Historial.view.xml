                                        type="Transparent"
                                        tooltip="Descargar PDF"
                                        class="accionHistorial"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>

                        <ColumnListItem id="reporteNoviembre2025" vAlign="Middle">
                            <cells>
                                <Text id="id28" text="Noviembre 2025"/>
                                <Text id="id29" text="Cliente Alpha S.A."/>
                                <Text id="id30" text="163.0 h"/>

                                <ObjectStatus
                                    id="id40"
                                    text="Aprobado por Cliente"
                                    state="Success"
                                    icon="sap-icon://status-positive"/>

                                <HBox id="id50" alignItems="Center" wrap="Wrap">
                                    <Button
                                        id="id61"
                                        text="Descargar PDF"
                                        icon="sap-icon://download"
                                        type="Transparent"
                                        tooltip="Descargar PDF"
                                        class="accionHistorial"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>

                    </items>
                </Table>
            </VBox>
              
        </content>
    </Page>
</mvc:View>