<mvc:View xmlns:form="sap.ui.layout.form"
	controllerName="ns.frontend.controller.RegistrarActividad"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page id="idRegistrarActividadPage" >
        <customHeader >
            <c:Fragment fragmentName="ns.frontend.fragment.Header" />
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin gapBody">
                <Breadcrumbs currentLocationText="{i18n>app1}">
                    <Link text="{i18n>tituloGrupo1}" press=".onBack" />
                </Breadcrumbs>

                <!-- Subtitulo y boton -->
                <FlexBox justifyContent="SpaceBetween" alignItems="End" >
                    <Title
                        level="H4" titleStyle="H4"
                        text="{uiPantalla>/saludo}"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                    <Button text="{i18n>save}" 
                        icon="sap-icon://save" 
                        type="Emphasized" 
                        class="sapUiSmallMarginBegin"
                        press=".onGuardar"    
                    />
                </FlexBox>
                <!-- <OverflowToolbar design="Transparent" class=" ">
                    <Title
                        level="H4" titleStyle="H4"
                        text="{uiPantalla>/saludo}">
                    </Title>
                    <ToolbarSpacer />
                    <Button text="Guardar" type="Emphasized"/>
                </OverflowToolbar> -->
           
                
                <!-- FORMULARIO DE REGISRTO DE ACTIVIDAD -->
                <form:SimpleForm 
                    editable="true" 
                    columnsM="2" columnsL="3" columnsXL="4"
                    title="{i18n>formRegistrarActividad}"
                    class="sapUiSmallMarginBottom"
                    layout="ColumnLayout"
                >
                    <form:content>
                        <Label text="{i18n>formFecha}" required="true" />
                        <DatePicker value="{uiPantalla>/fechaCaptura}" />

                        <Label text="{i18n>formTipoActividad}" required="true" />
                        <Input placeholder="Ej. Desarrollo" value="{uiPantalla>/tipoActividad}" id="tipoActividadInput"/>

                        <Label text="{i18n>formHInvertidas}" required="true" />
                        <Input type="Number" placeholder="Ej. 3.5" value="{uiPantalla>/horasInvertidas}" id="horasInvertidasInput"/>

                        <Label text="." /> 
                        <CheckBox 
                            text="{i18n>formCapacitacion}" 
                            selected="{uiPantalla>/esCapacitacion}" />

                        <Label text="{i18n>customer}" required="true" />
                        <Input enabled="{= !${uiPantalla>/esCapacitacion} }" placeholder="Ej. Cliente Alpha S.A." value="{uiPantalla>/cliente}" id="clienteInput"/>

                        <Label text="{i18n>project}" required="true" />
                        <Input enabled="{= !${uiPantalla>/esCapacitacion} }" placeholder="Ej. Implementación RAP" value="{uiPantalla>/proyecto}" id="proyectoInput"/>

                        <Label text="{i18n>formRequerimiento}" required="true" />
                        <Input placeholder="Ej. REQ-00231" value="{uiPantalla>/requerimiento}" id="requerimientoInput"/>

                        <Label text="{i18n>formDescripcion}" required="true" />
                        <TextArea 
                            placeholder="Ej. Desarrollo de validaciones en Behavior Implementation..."
                            rows="4"
                            growing="true"
                            growingMaxLines="7"
                            width="100%" 
                            value="{uiPantalla>/descripcion}"
                            id="descripcionInput"
                        />
                    </form:content>
                </form:SimpleForm>

                <!-- Tabla de actividades registradas hoy -->
                <Table headerText="{uiPantalla>/tableTitle}" items="{modelo>/}">
                    <columns>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>tblHora}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>customer}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>formRequerimiento}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>description}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>tblHoras}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active" press=".onFilaClickeada" >
                            <cells>
                                <Text text="{modelo>fecha}" />
                                <Text text="{modelo>cliente}" />
                                <Text text="{modelo>requerimiento}" />
                                <Text text="{modelo>descripcion}" />
                                <Text text="{modelo>horas} h" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>


            </VBox>
        </content>

        <!-- Horas registradas -->
        <footer>
            <OverflowToolbar >
                <ObjectStatus 
                    text="{uiPantalla>/horasTotales}" 
                    state="Success" 
                    class="sapMTitleStyleH5 " 
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>