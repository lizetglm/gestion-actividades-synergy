<mvc:View xmlns:form="sap.ui.layout.form"
	controllerName="ns.frontend.controller.RegistrarActividad"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page id="idRegistrarActividadPage" showHeader="false" backgroundDesign="Transparent">
        <!-- <customHeader >
            <c:Fragment fragmentName="ns.frontend.fragment.Header" />
        </customHeader> -->
        <content>
            <VBox class="sapUiMediumMargin gapBody">
                <Breadcrumbs currentLocationText="{i18n>app1}">
                    <Link text="{i18n>tituloGrupo1}" press=".onBack" />
                </Breadcrumbs>

                <!-- Subtitulo y boton -->
                <FlexBox justifyContent="SpaceBetween" alignItems="End" >
                    <Title
                        level="H4" titleStyle="H4"
                        text="{uiPantalla>/saludo}"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                    <Button text="{i18n>save}" 
                        icon="sap-icon://save" 
                        type="Emphasized" 
                        class="sapUiSmallMarginBegin"
                        press=".onGuardar"    
                    />
                </FlexBox>

                <Panel >
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Contexto de Trabajo" level="H3"/>
                            <ToolbarSpacer />
                            <ObjectStatus 
                                text="{= ${uiPantalla>/esCapacitacion} ? 'Modo: Capacitación Interna' : ((${uiPantalla>/cliente} &amp;&amp; ${uiPantalla>/proyecto}) ? 'Activo: ' + ${uiPantalla>/cliente} : 'Pendiente de seleccionar') }"
                                state="{= ${uiPantalla>/esCapacitacion} || (${uiPantalla>/cliente} &amp;&amp; ${uiPantalla>/proyecto}) ? 'Success' : 'Warning' }" 
                                icon="{= ${uiPantalla>/esCapacitacion} || (${uiPantalla>/cliente} &amp;&amp; ${uiPantalla>/proyecto}) ? 'sap-icon://status-positive' : 'sap-icon://alert' }"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <VBox >
                            <!-- <Label text="¿Es una actividad de capacitación interna?" class="sapUiTinyMarginTop" />  -->
                            <CheckBox 
                                text="{i18n>formCapacitacion}" 
                                selected="{uiPantalla>/esCapacitacion}"
                                class="sapUiTinyMarginTop" />

                            <form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" >
                                <form:content>
                                    <Label text="{i18n>customer}" required="true" />
                                    <Select id="clienteSelect" 
                                        wrapItemsText="true" 
                                        enabled="{= !${uiPantalla>/esCapacitacion} }"
                                        selectedKey="{uiPantalla>/cliente}"
                                    >
                                        <items>
                                            <c:Item key="" text="-- Seleccione un cliente --" />
                                            <c:Item key="cliente1" text="Cliente Alpha S.A." />
                                            <c:Item key="cliente2" text="Cliente Beta S.A." />
                                            <c:Item key="cliente3" text="Cliente Gamma S.A." />
                                        </items>
                                    </Select>

                                    <Label text="{i18n>project}" required="true" />
                                    <Select id="proyectoSelect"
                                        wrapItemsText="true" 
                                        enabled="{= !${uiPantalla>/esCapacitacion} }"
                                        selectedKey="{uiPantalla>/proyecto}"
                                    >
                                        <items>
                                            <c:Item key="" text="-- Seleccione un proyecto --" />
                                            <c:Item key="Implementación RAP" text="Implementación RAP" />
                                            <c:Item key="Desarrollo Fiori" text="Desarrollo Fiori" />
                                            <c:Item key="Integración BTP" text="Integración BTP" />
                                        </items>
                                    </Select>
                                </form:content>
                            </form:SimpleForm>
                        </VBox>
                    </content>
                </Panel>
                
                <!-- FORMULARIO DE REGISRTO DE ACTIVIDAD -->
                <form:SimpleForm 
                    editable="true" 
                    columnsM="2" columnsL="3" columnsXL="4"
                    title="{i18n>formRegistrarActividad}"
                    class="sapUiSmallMarginBottom"
                    layout="ColumnLayout"
                >
                    <form:content>
                        <Label text="{i18n>formFecha}" required="true" />
                        <DatePicker value="{uiPantalla>/fechaCaptura}" />

                        <Label text="{i18n>formTipoActividad}" required="true" />
                        <Input placeholder="Ej. Desarrollo" value="{uiPantalla>/tipoActividad}" id="tipoActividadInput"/>

                        <Label text="{i18n>formHInvertidas}" required="true" />
                        <Input type="Number" placeholder="Ej. 3.5" value="{uiPantalla>/horasInvertidas}" id="horasInvertidasInput"/>

                        <Label text="{i18n>formRequerimiento}" required="true" />
                        <Input placeholder="Ej. REQ-00231" value="{uiPantalla>/requerimiento}" id="requerimientoInput"/>

                        <Label text="{i18n>formDescripcion}" required="true" />
                        <TextArea 
                            placeholder="Ej. Desarrollo de validaciones en Behavior Implementation..."
                            rows="4"
                            growing="true"
                            growingMaxLines="7"
                            width="100%" 
                            value="{uiPantalla>/descripcion}"
                            id="descripcionInput"
                        />
                    </form:content>
                </form:SimpleForm>

                <!-- Tabla de actividades registradas hoy -->
                <Table headerText="{uiPantalla>/tableTitle}" items="{modelo>/}">
                    <columns>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>tblHora}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>customer}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>formRequerimiento}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>description}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>tblHoras}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active" press=".onFilaClickeada" >
                            <cells>
                                <Text text="{modelo>fecha}" />
                                <Text text="{modelo>cliente}" />
                                <Text text="{modelo>requerimiento}" />
                                <Text text="{modelo>descripcion}" />
                                <Text text="{modelo>horas} h" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>


            </VBox>
        </content>

        <!-- Horas registradas -->
        <footer>
            <OverflowToolbar >
                <ObjectStatus 
                    text="{uiPantalla>/horasTotales}" 
                    state="Success" 
                    class="sapMTitleStyleH5 " 
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>