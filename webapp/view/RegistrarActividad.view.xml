<mvc:View id="vistaRegistrarActividad"
    xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form"
	controllerName="ns.frontend.controller.RegistrarActividad"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page id="idRegistrarActividadPage" showHeader="false" backgroundDesign="Transparent" class="sapUiResponsiveContentPadding" >
        <!-- <customHeader >
            <c:Fragment fragmentName="ns.frontend.fragment.Header" />
        </customHeader> -->
        <content>
            <VBox class="sapUiSmallMargin gapBody">
                <Breadcrumbs currentLocationText="{i18n>app1}">
                    <Link text="{i18n>tituloGrupo1}" press=".onBack" />
                </Breadcrumbs>

                <FlexBox justifyContent="SpaceBetween" alignItems="End" >
                    <Title
                        level="H4" titleStyle="H4"
                        text="{uiPantalla>/saludo}"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                    <Button text="{i18n>save}" 
                        icon="sap-icon://save" 
                        type="Emphasized" 
                        class="sapUiSmallMarginBegin"
                        press=".onGuardar"    
                    />
                </FlexBox>

                <!-- FORMULARIO DE REGISRTO DE ACTIVIDAD -->
                <!-- CONTEXTO DE TRABAJO -->
                <Panel class="sapUiResponsiveContentPadding">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>contextoTrabajo}" level="H3"/>
                            <ToolbarSpacer />
                            <ObjectStatus 
                                text="{= (( ${uiPantalla>/esCapacitacion} &amp;&amp; ${uiPantalla>/cliente} )) ? 'Modo: Capacitación Interna' : ((${uiPantalla>/cliente} &amp;&amp; ${uiPantalla>/proyecto}) ? 'Activo: ' + ${uiPantalla>/cliente} : 'Pendiente de seleccionar') }"
                                state="{= (${uiPantalla>/esCapacitacion} &amp;&amp; ${uiPantalla>/cliente}) || (${uiPantalla>/cliente} &amp;&amp; ${uiPantalla>/proyecto}) ? 'Success' : 'Warning' }" 
                                icon="{= (${uiPantalla>/esCapacitacion} &amp;&amp; ${uiPantalla>/cliente}) || (${uiPantalla>/cliente} &amp;&amp; ${uiPantalla>/proyecto}) ? 'sap-icon://status-positive' : 'sap-icon://alert' }"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <VBox >
                            <CheckBox 
                                text="{i18n>formCapacitacion}" 
                                selected="{uiPantalla>/esCapacitacion}"
                                class="sapUiTinyMarginTop sapUiSmallMarginBottom" />

                            <layout:Grid defaultSpan="L6 M6 S12" >
                                <HBox width="100%" alignItems="Center" wrap="Wrap">
                                    <Label text="{i18n>customer}" required="true" class="sapUiSmallMarginEnd" />
                                    <Select id="clienteSelect" 
                                        wrapItemsText="true" 
                                        selectedKey="{uiPantalla>/cliente}"
                                    >
                                        <items>
                                            <c:Item key="" text="-- Seleccione un cliente --" />
                                            <c:Item key="cliente1" text="Cliente Alpha S.A." />
                                            <c:Item key="cliente2" text="Cliente Beta S.A." />
                                            <c:Item key="cliente3" text="Cliente Gamma S.A." />
                                        </items>
                                    </Select>
                                </HBox>
                                <HBox width="100%" alignItems="Center" wrap="Wrap">
                                    <Label text="{i18n>project}" required="true" class="sapUiSmallMarginEnd" />
                                    <Select id="proyectoSelect"
                                        wrapItemsText="true" 
                                        enabled="{= !${uiPantalla>/esCapacitacion} }"
                                        selectedKey="{uiPantalla>/proyecto}"
                                    >
                                        <items>
                                            <c:Item key="" text="-- Seleccione un proyecto --" />
                                            <c:Item key="Implementación RAP" text="Implementación RAP" />
                                            <c:Item key="Desarrollo Fiori" text="Desarrollo Fiori" />
                                            <c:Item key="Integración BTP" text="Integración BTP" />
                                        </items>
                                    </Select>
                                </HBox>
                            </layout:Grid>
                        </VBox>
                    </content>
                </Panel>
                
                <!-- DATOS DE LA ACTIVIDAD -->
                <Panel headerText="{i18n>formRegistrarActividad}" class="sapUiResponsiveContentPadding" >
                    <content>
                        <layout:Grid defaultSpan="L12 M12 S12" class="sapUiSmallMarginTop">
                            <VBox>
                                <layoutData>
                                    <layout:GridData span="L6 M6 S12"/>
                                </layoutData>
                                
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>formFecha}" required="true" />
                                    <DatePicker value="{uiPantalla>/fechaCaptura}" width="100%" change=".onFechaChange" />
                                </VBox>

                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>formHInvertidas}" required="true" />
                                    <Input type="Number" placeholder="Ej. 3.5" value="{uiPantalla>/horasInvertidas}" id="horasInvertidasInput" width="100%" />
                                </VBox>

                                <VBox visible="{= !${uiPantalla>/esCapacitacion} }">
                                    <Label text="{i18n>formRequerimiento}" required="true" />
                                    <Input placeholder="Ej. REQ-00231" value="{uiPantalla>/requerimiento}" id="requerimientoInput" width="100%" />
                                </VBox>
                            </VBox>

                            <VBox>
                                <layoutData>
                                    <layout:GridData span="L6 M6 S12"/>
                                </layoutData>
                                
                                <Label text="{i18n>formDescripcion}" required="true" />
                                <TextArea id="descripcionInput"
                                    placeholder="Ej. Curso avanzado de SAP RAP y BTP. Ej. Desarrollo de validaciones en Behavior Implementation..."
                                    rows="7"
                                    width="100%" 
                                    value="{uiPantalla>/descripcion}"
                                />
                            </VBox>

                        </layout:Grid>
                    </content>
                </Panel>

                <!-- TABLA DE ACTIVIDADES REGISTRADAS HOY -->
                <Title class="sapUiSmallMarginTop"
                    level="H4" titleStyle="H4"
                    text="{uiPantalla>/tableTitle}"
                    wrapping="true"
                    wrappingType="Hyphenated">
                </Title>
                <Table items="{modeloFiltrado>/}" alternateRowColors="true" >
                    <headerToolbar>
                        <OverflowToolbar>
                            <ToolbarSpacer/>
                            <Button text="Exportar a Excel" icon="sap-icon://excel-attachment" tooltip="Exportar a Excel" press=".onExportarExcel" type="Success"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>tblHora}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>customer}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>formRequerimiento}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>description}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>tblHoras}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active" press=".onFilaClickeada" >
                            <cells>
                                <Text text="{modeloFiltrado>fecha}" />
                                <Text text="{modeloFiltrado>cliente}" />
                                <Text text="{modeloFiltrado>requerimiento}" />
                                <Text text="{modeloFiltrado>descripcion}" />
                                <Text text="{modeloFiltrado>horas} h" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>

        <!-- HORAS REGISTRADAS TOTAL -->
        <footer>
            <OverflowToolbar >
                <ObjectStatus 
                    text="{uiPantalla>/horasTotales}" 
                    state="Success" 
                    class="sapMTitleStyleH5 " />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>