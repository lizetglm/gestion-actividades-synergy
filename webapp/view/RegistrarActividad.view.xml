<mvc:View id="vistaRegistrarActividad"
    xmlns:layout="sap.ui.layout" xmlns:form="sap.ui.layout.form"
	controllerName="ns.frontend.controller.RegistrarActividad"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page id="idRegistrarActividadPage" showHeader="false" backgroundDesign="Transparent" class="sapUiResponsiveContentPadding" >
        <!-- <customHeader >
            <c:Fragment fragmentName="ns.frontend.fragment.Header" />
        </customHeader> -->
        <content>
            <VBox class="sapUiSmallMargin gapBody">
                <Breadcrumbs currentLocationText="{i18n>app1}">
                    <Link text="{i18n>tituloGrupo1}" press=".onBack" />
                </Breadcrumbs>

                <FlexBox justifyContent="SpaceBetween" alignItems="End" >
                    <Title
                        level="H4" titleStyle="H4"
                        text="{uiPantalla>/saludo}"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                    <Button text="{i18n>save}" 
                        icon="sap-icon://save" 
                        type="Emphasized" 
                        class="sapUiSmallMarginBegin"
                        press=".onGuardar"    
                    />
                </FlexBox>

                <!-- FORMULARIO DE REGISRTO DE ACTIVIDAD -->
                <Panel class="sapUiResponsiveContentPadding">
                    <content>
                        <layout:Grid defaultSpan="L6 M6 S12" class="sapUiSmallMarginTop">
                            <!-- Izquierda (Contexto del trabajo)-->
                            <VBox>
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>customer}" required="true" />
                                    <Select id="clienteSelect" width="100%" wrapItemsText="true" selectedKey="{uiPantalla>/cliente}">
                                        <items>
                                            <c:Item key="" text="-- Seleccione un cliente --" />
                                            <c:Item key="cliente1" text="Cliente Alpha S.A." />
                                            <c:Item key="cliente2" text="Cliente Beta S.A." />
                                            <c:Item key="cliente3" text="Cliente Gamma S.A." />
                                        </items>
                                    </Select>
                                </VBox>

                                <CheckBox text="{i18n>formCapacitacion}" selected="{uiPantalla>/esCapacitacion}" class="sapUiTinyMarginBottom" />
                                
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>project}" required="true" />
                                    <Select id="proyectoSelect" width="100%" wrapItemsText="true" enabled="{= !${uiPantalla>/esCapacitacion} }" selectedKey="{uiPantalla>/proyecto}">
                                        <items>
                                            <c:Item key="" text="-- Seleccione un proyecto --" />
                                            <c:Item key="Implementación RAP" text="Implementación RAP" />
                                            <c:Item key="Desarrollo Fiori" text="Desarrollo Fiori" />
                                            <c:Item key="Integración BTP" text="Integración BTP" />
                                        </items>
                                    </Select>
                                </VBox>

                                <VBox class="sapUiTinyMarginBottom" >
                                    <Label text="{i18n>formRequerimiento}" required="true" />
                                    <Input placeholder="Ej. REQ-00231" value="{uiPantalla>/requerimiento}" id="requerimientoInput" width="100%" enabled="{= !${uiPantalla>/esCapacitacion} }"/>
                                </VBox>
                            </VBox>

                            <!-- Derecha -->
                            <VBox>
                                <layout:Grid defaultSpan="L6 M6 S12" hSpacing="0" >
                                    <VBox class="sapUiTinyMarginBottom sapUiTinyMarginEnd">
                                        <Label text="{i18n>formFecha}" required="true" />
                                        <DatePicker value="{uiPantalla>/fechaCaptura}" width="100%" change=".onFechaChange" />
                                    </VBox>

                                    <VBox class="sapUiTinyMarginBottom">
                                        <Label text="{i18n>formHInvertidas}" required="true" />
                                        <Input type="Number" placeholder="Ej. 3.5" value="{uiPantalla>/horasInvertidas}" id="horasInvertidasInput" width="100%" />
                                    </VBox>
                                </layout:Grid>

                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>formDescripcion}" required="true" />
                                    <TextArea id="descripcionInput"
                                        placeholder="Ej. Curso avanzado de SAP RAP y BTP. Desarrollo de validaciones..."
                                        rows="5"
                                        width="100%" 
                                        value="{uiPantalla>/descripcion}"
                                    />
                                </VBox>
                            </VBox>

                        </layout:Grid>
                    </content>
                </Panel>

                <!-- TABLA DE ACTIVIDADES REGISTRADAS HOY -->
                <Title class="sapUiSmallMarginTop"
                    level="H4" titleStyle="H4"
                    text="{uiPantalla>/tableTitle}"
                    wrapping="true"
                    wrappingType="Hyphenated">
                </Title>
                <Table items="{modeloFiltrado>/}" alternateRowColors="true" >
                    <headerToolbar>
                        <OverflowToolbar>
                            <ToolbarSpacer/>
                            <Button text="Exportar a Excel" icon="sap-icon://excel-attachment" tooltip="Exportar a Excel" press=".onExportarExcel" type="Emphasized"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>formFecha}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>customer}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>formRequerimiento}" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>description}" />
                        </Column>
                        <Column width="8rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>tblHoras}" />
                        </Column>
                        <Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                            <Text text="{i18n>actions}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Active" press=".onFilaClickeada" >
                            <cells>
                                <Text text="{modeloFiltrado>fecha}" />
                                <Text text="{modeloFiltrado>cliente}" />
                                <Text text="{modeloFiltrado>requerimiento}" />
                                <Text text="{modeloFiltrado>descripcion}" />
                                <Text text="{modeloFiltrado>horas} h" />
                                <HBox gap="0.5rem" justifyContent="Center">
                                    <Button icon="sap-icon://edit" press=".onEditarActividad" type="Attention"/>
                                    <Button icon="sap-icon://delete" press=".onEliminarActividad" type="Reject"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>

        <!-- HORAS REGISTRADAS TOTAL -->
        <footer>
            <OverflowToolbar >
                <ObjectStatus 
                    text="{uiPantalla>/horasTotales}" 
                    state="Success" 
                    class="sapMTitleStyleH5 " />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>