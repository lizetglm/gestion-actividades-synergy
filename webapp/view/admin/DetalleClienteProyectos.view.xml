<mvc:View
    controllerName="ns.frontend.controller.admin.DetalleClienteProyectos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
    height="100%"
    busyIndicatorDelay="0"
>
    <uxap:ObjectPageLayout id="idDetalleObjectPageLayout" showTitleInHeaderContent="true">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="Cliente: {modeloClientes>nombre}" wrapping="true"/>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <FlexBox fitContainer="true" alignItems="Center">
                        <Avatar src="sap-icon://picture" backgroundColor="Random" class="sapUiTinyMarginEnd"/>
                        <Title text="Cliente: {modeloClientes>nombre}" wrapping="true" />
                    </FlexBox>
                </uxap:snappedHeading>

            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

		<uxap:headerContent>
            <VBox class="sapUiSmallMarginBottom">
                <Breadcrumbs currentLocationText="{i18n>appAdmin2.1}">
                    <Link text="&lt; {i18n>appAdmin2}" press=".onBack" />
                </Breadcrumbs>
            </VBox>
			<FlexBox wrap="Wrap">
				<Avatar src="sap-icon://picture" backgroundColor="Random" displaySize="M" class="sapUiTinyMarginEnd"/>

				<layout:VerticalLayout class="sapUiSmallMarginBeginEnd">
					<ObjectStatus title="User ID" text="12345678"/>
					<ObjectStatus title="{i18n>language}" text="English"/>
					<ObjectStatus title="{i18n>country}" text="MEX"/>
				</layout:VerticalLayout>

				<layout:VerticalLayout class="sapUiSmallMarginBeginEnd">
					<ObjectStatus title="{i18n>area}" text="Developement"/>
					<ObjectStatus title="{i18n>numTelefono}" text="1-844-726-7733"/>
					<ObjectStatus title="{i18n>email}" text="email@address.com"/>
				</layout:VerticalLayout>
			</FlexBox>
		</uxap:headerContent>

        <uxap:sections>
            <!-- Proyectos Asociados  -->
            <uxap:ObjectPageSection title="{i18n>seccionProyectos}" class="sapUiSmallMarginTopBottom" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection >
                        <uxap:blocks>
                            <Table 
                                id="tablaProyectosDetalle"
                                items="{modeloClientes>proyectos}" 
                                alternateRowColors="true"
                            >
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>titleTableProyectos}" level="H3" />
                                        <ToolbarSpacer />
                                        <Button text="{i18n>btnNuevoProyecto}" type="Emphasized" icon="sap-icon://add" press=".onNuevoProyecto" />
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" width="150px">
                                        <Text text="{i18n>id}" />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>nameProject}" />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>description}" />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" width="150px">
                                        <Text text="{i18n>estatus}" />
                                    </Column>
                                    <Column width="200px" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="Acciones" design="Bold" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem type="Active" press=".onDetalleProyecto">
                                        <cells>
                                            <Text text="{modeloClientes>idProyecto}" />
                                            <Text text="{modeloClientes>nombreProyecto}" />
                                            <Text text="{modeloClientes>descripcion}" />
                                            <ObjectStatus text="{modeloClientes>estatusProyecto}" state="Information" />
                                            <HBox justifyContent="End" gap="0.6rem">
                                                <Button icon="sap-icon://list" type="Neutral" tooltip="Gestionar Requerimientos" press=".onVerRequerimientos"  />
                                                <Button icon="sap-icon://edit" type="Attention" tooltip="Editar" press=".onEditarProyecto" />
                                                <Button icon="sap-icon://delete" type="Reject" tooltip="Inactivar" press=".onInactivarProyecto" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Consultores Asignados -->
            <uxap:ObjectPageSection title="{i18n>seccionConsultores}" titleUppercase="false" class="sapUiSmallMarginTopBottom sapUiMediumMarginBottom">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table 
                                id="tablaConsultoresDetalle"
                                items="{
                                    path: 'modeloClientes>consultores',
                                    sorter: {
                                        path: 'proyectoAsignado',
                                        group: true
                                    }
                                }"
                            >
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>titleTableConsultores}" level="H3" />
                                        <ToolbarSpacer />
                                        <Button text="{i18n>btnAsignarConsultor}" 
                                                type="Emphasized" 
                                                icon="sap-icon://add-employee" 
                                                press=".onAsignarConsultor" 
                                        />
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>consultant}" /> 
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>project}" /> 
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>rolProyecto}" /> 
                                    </Column>
                                     <Column width="100px" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>actions}"/>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{modeloClientes>nombreConsultor}" />
                                            <Text text="{modeloClientes>proyectoAsignado}" />
                                            <Text text="{modeloClientes>rol}" />
                                            <HBox justifyContent="End">
                                                <Button icon="sap-icon://decline" type="Reject" tooltip="Inactivar" press=".onInactivarConsultor" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>

    </uxap:ObjectPageLayout>
</mvc:View>