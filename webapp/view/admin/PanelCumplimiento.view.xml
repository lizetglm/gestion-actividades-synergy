<mvc:View id="vistaPanelCumplimiento"
    xmlns:layout="sap.ui.layout"
	controllerName="ns.frontend.controller.admin.PanelCumplimiento"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	displayBlock="true" height="100%" busyIndicatorDelay="0"
    xmlns:f="sap.f"
    xmlns:mc="sap.suite.ui.microchart"
>
    <f:DynamicPage id="pagePanel"  showFooter="true">
        <f:title>
            <f:DynamicPageTitle id="idPanelCDynamicPageTitle">
                <f:breadcrumbs >
                   <Breadcrumbs currentLocationText="{i18n>appAdmin1}"
                    class="sapUiSmallMarginTopBottom">
                        <Link text="{i18n>tituloGrupo1}" press=".onBack" />
                    </Breadcrumbs>
                </f:breadcrumbs>
                
                <f:heading>
                    <Title
                        level="H4" titleStyle="H4"
                        text="{uiPantalla>/saludo}"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                </f:heading>

                <f:actions>
                    <Button  tooltip="{i18n>btnImpDetalle}"  icon="sap-icon://print" press=".onImprimirPantalla" />    
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <!-- Filtors -->
                <FlexBox wrap="Wrap" class="gapPanelFiltros" >
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Periodo" />
                        <Select id="filtroPeriodo" width="200px" selectedKey="Oct2026" change=".onFiltroGlobalChange" >
                            <c:Item key="Sep2026" text="Septiembre 2026" />
                            <c:Item key="Oct2026" text="Octubre 2026" />
                        </Select>
                    </VBox>
                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="{i18n>customer}" />
                        <Select id="filtroCliente" width="200px" selectedKey="Todos" change=".onFiltrarDashboard" >
                            <c:Item key="Todos" text="Todos" />
                            <c:Item key="Alpha" text="Cliente Alpha S.A." />
                            <c:Item key="Beta" text="Cliente Beta" />
                        </Select>
                    </VBox>
                    <VBox>
                        <Label text="{i18n>filtro2}" />
                        <Select id="filtroEquipo" width="200px" selectedKey="Todos" change=".onFiltrarDashboard">
                            <c:Item key="Todos" text="Todos" />
                            <c:Item key="SAP" text="Consultoría SAP" />
                            <c:Item key="BTP" text="Integración BTP" />
                        </Select>
                    </VBox>
                </FlexBox>

                <!-- Indicadores (KPI Tiles) -->
                <layout:Grid class="noPadding sapUiSmallMarginTop" >
                    <VBox id="kpiActivos" class="tarjetaKpi bordeAzul sapMPointer">
                        <FlexBox direction="Column" alignItems="Center" justifyContent="Center" height="100%">
                            <Text text="{i18n>kpiPanel1}" class="sapMTitleStyleH5 sapUiTinyMarginBottom" />
                            <Title level="H1" text="{uiPantalla>/kpis/activos}" class="textoAzul" />
                        </FlexBox>
                    </VBox>

                    <VBox id="kpiCompletos" class="tarjetaKpi bordeVerde sapMPointer">
                        <FlexBox direction="Column" alignItems="Center" justifyContent="Center" height="100%">
                            <Text text="{i18n>kpiPanel2}" class="sapMTitleStyleH5 sapUiTinyMarginBottom" />
                            <Title level="H1" text="{uiPantalla>/kpis/completos}" class="textoVerde" />
                        </FlexBox>
                    </VBox>

                    <VBox id="kpiPendientes" class="tarjetaKpi bordeNaranja sapMPointer" >
                        <FlexBox direction="Column" alignItems="Center" justifyContent="Center" height="100%">
                            <Text text="{i18n>kpiPanel3}" class="sapMTitleStyleH5 sapUiTinyMarginBottom" />
                            <Title level="H1" text="{uiPantalla>/kpis/pendientes}" class="textoNaranja" />
                        </FlexBox>
                    </VBox>

                    <VBox id="kpiSinFirmar" class="tarjetaKpi bordeRojo sapMPointer" >
                        <FlexBox direction="Column" alignItems="Center" justifyContent="Center" height="100%">
                            <Text text="{i18n>kpiPanel4}" class="sapMTitleStyleH5 sapUiTinyMarginBottom" />
                            <Title level="H1" text="{uiPantalla>/kpis/sinFirmar}" class="textoRojo" />
                        </FlexBox>
                    </VBox>
                </layout:Grid>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <!-- Tabla de detalles por consultor -->
            <Table id="tablaCumplimiento"
                items="{
                    path: 'modelo>/oModelo',
                    sorter: [
                        { path: 'cliente', descending: false },
                        { path: 'estatusReg', descending: false }
                    ]
                }"
                class="tablaFondoColor sapUiMediumMarginBottom"
                updateFinished=".onCalcularKPIs"
            >
                <headerToolbar>
                    <Toolbar id="toolbarTablaCumplimiento">
                        <Title id="tituloTablaCumplimiento" text="{uiPantalla>/tituloTabla}" level="H3"/>
                        <ToolbarSpacer />
                        <Button icon="sap-icon://sort" tooltip="Ordenar" press=".onAbrirOrdenamiento" />
                        <Button tooltip="{i18n>btnExportarExcel}" icon="sap-icon://excel-attachment" press=".onExportarExcel"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="{i18n>consultant}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="{i18n>customer}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="{i18n>filtro2}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="{i18n>estatusReg}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="{i18n>estatusFirma}" />
                    </Column>
                    <Column width="6rem" ><Text text="{i18n>avance}" /></Column>
                </columns>

                <items>
                    <ColumnListItem 
                        highlight="{= (${modelo>estatusFirma} === 'Sin firmar' ? 'Error' : ${modelo>estatusReg} === 'Pendiente' ? 'Warning' : 'None') }"
                    >
                        <customData>
                            <c:CustomData key="estadoreg" value="{modelo>estatusReg}" writeToDom="true" />
                            <c:CustomData key="estadofirma" value="{modelo>estatusFirma}" writeToDom="true" />
                        </customData>
                        
                        <cells>
                            <Text text="{modelo>nombre}" />
                            <Text text="{modelo>cliente}" />
                            <Text text="{modelo>equipo}" />
                            <ObjectStatus 
                                text="{modelo>estatusReg}" 
                                state="{= ${modelo>estatusReg} === 'Completo' ? 'Success' : (${modelo>estatusReg} === 'Pendiente' ? 'Warning' : 'None') }" />
                            <ObjectStatus 
                                text="{modelo>estatusFirma}" 
                                state="{= ${modelo>estatusFirma} === 'Firmado' ? 'Success' : (${modelo>estatusFirma} === 'Sin firmar' ? 'Error' : 'None') }" 
                            />
                            <mc:RadialMicroChart  size="XS" 
                                percentage="{modelo>porcentajeAvance}" 
                                valueColor="{= ${modelo>porcentajeAvance} === 100 ? 'Good' : 'Critical'}" 
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Recordatorio Masivo" 
                    icon="sap-icon://email" 
                    type="Neutral" 
                    press=".onRecordatorioMasivo" 
                    tooltip="Enviar alerta a pendientes" 
                    class="sapUiTinyMarginEnd" 
                />
                <Button text="Consolidar Reportes" 
                    icon="sap-icon://complete" 
                    type="Accept" 
                    press=".onConsolidar" 
                    tooltip="Navegar a consolidar reportes" 
                    class="sapUiTinyMarginEnd" 
                />
            </OverflowToolbar>
        </f:footer>

    </f:DynamicPage>
</mvc:View>