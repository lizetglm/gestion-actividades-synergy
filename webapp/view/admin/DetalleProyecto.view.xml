<mvc:View
    controllerName="ns.frontend.controller.admin.DetalleProyecto"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:uxap="sap.uxap"
    displayBlock="true"
    height="100%"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
    <uxap:ObjectPageLayout id="pageDetalleProyecto" showTitleInHeaderContent="true" showFooter="true">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="Proyecto: {modeloClientes>nombreProyecto}" wrapping="true"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title text="{modeloClientes>nombreProyecto}" wrapping="true" />
                </uxap:snappedHeading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <VBox class="sapUiSmallMarginBottom">
                <Breadcrumbs currentLocationText="{i18n>appAdmin2.2}" >
                    <Link text="&lt; {i18n>appAdmin2.1}" press=".onBack" />
                </Breadcrumbs>
            </VBox>
            <layout:VerticalLayout class="sapUiSmallMarginBeginEnd">
                <ObjectStatus title="ID" text="{modeloClientes>idProyecto}"/>
                <ObjectStatus title="Fecha de Inicio" text="{modeloClientes>fechaInicio}"/>
                <ObjectStatus title="Fecha de Fin" text="{modeloClientes>fechaFin}"/>
                <ObjectStatus title="Estatus" text="{modeloClientes>estatusProyecto}" state="Information"/>
            </layout:VerticalLayout>
        </uxap:headerContent>

        <uxap:sections>
            <uxap:ObjectPageSection title="{i18n>tblReqFuncionales}" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table 
                                items="{
                                    path: 'modeloClientes>requerimientos',
                                    filters: [{path: 'tipo', operator: 'EQ', value1: 'RF'}]
                                }"
                                alternateRowColors="true" 
                                mode="MultiSelect"
                            >
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>tblReqFuncionales}" level="H3" />
                                        <ToolbarSpacer />
                                        <SearchField width="30%" search=".onBuscarRequerimiento" placeholder="Buscar RF..." app:tipoTabla="RF"/>
                                        <Button text="{i18n>btnNewReq}" type="Emphasized" icon="sap-icon://add" press=".onNuevoRequerimiento" app:tipoReq="RF" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="10rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="ID Req." />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>description}" />
                                    </Column>
                                    <Column width="6rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>estatus}" />
                                    </Column>
                                    <Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>actions}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{modeloClientes>idRequerimiento}" />
                                            <Text text="{modeloClientes>descripcion}" />
                                            <ObjectStatus text="{modeloClientes>estatus}" state="{= ${modeloClientes>estatus} === 'Activo' ? 'Success' : 'Error'}" />
                                            <HBox justifyContent="End" gap="0.6rem">
                                                <Button icon="sap-icon://edit" type="Attention" tooltip="Editar" press=".onEditRequerimiento" />
                                                <Button icon="sap-icon://delete" type="Reject" tooltip="Eliminar" press=".onDeleteRequerimiento" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="{i18n>tblReqNoFuncionales}">
                        <uxap:blocks>
                            <Table 
                                items="{
                                    path: 'modeloClientes>requerimientos',
                                    filters: [{path: 'tipo', operator: 'EQ', value1: 'RNF'}]
                                }"
                                alternateRowColors="true" 
                                mode="MultiSelect"
                            >
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>tblReqNoFuncionales}" level="H3" />
                                        <ToolbarSpacer />
                                        <SearchField width="30%" search=".onBuscarRequerimiento" placeholder="Buscar RNF..." app:tipoTabla="RNF"/>
                                        <Button text="{i18n>btnNewReq}" type="Emphasized" icon="sap-icon://add" press=".onNuevoRequerimiento" app:tipoReq="RNF" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="10rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="ID Req." />
                                    </Column>
                                    <Column width="15rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>category}" />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>description}" />
                                    </Column>
                                    <Column width="6rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>estatus}" />
                                    </Column>
                                    <Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>actions}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{modeloClientes>idRequerimiento}" />
                                            <Text text="{modeloClientes>categoria}" />
                                            <Text text="{modeloClientes>descripcion}" />
                                            <ObjectStatus text="{modeloClientes>estatus}" state="{= ${modeloClientes>estatus} === 'Activo' ? 'Success' : 'Error'}" />
                                            <HBox justifyContent="End" gap="0.6rem">
                                                <Button icon="sap-icon://edit" type="Attention" tooltip="Editar" press=".onEditRequerimiento" />
                                                <Button icon="sap-icon://delete" type="Reject" tooltip="Eliminar" press=".onDeleteRequerimiento" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>

        <uxap:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Inactivar Seleccionados" type="Reject" press=".onInactivarMasivo" />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>