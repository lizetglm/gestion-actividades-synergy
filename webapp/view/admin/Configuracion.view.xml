<mvc:View
    id="viewConfiguracion"
    controllerName="ns.frontend.controller.admin.Configuracion"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%"
    xmlns:layout="sap.ui.layout"
    busyIndicatorDelay="0"
    xmlns:f="sap.f"
    xmlns:mc="sap.suite.ui.microchart"
    >

    <f:DynamicPage 
        id="pageConfig"  
        showFooter="true">

        <f:title>
            <f:DynamicPageTitle id="idPanelCDynamicPageTitleConfig">
                <f:breadcrumbs >
                   <Breadcrumbs id="breadConfig" currentLocationText="{i18n>appAdmin4}"
                    class="sapUiSmallMarginTopBottom">
                        <Link id="linkConfig" text="{i18n>tituloGrupo1}" press=".onBack" />
                    </Breadcrumbs>
                </f:breadcrumbs>
                
                <f:heading>
                    <Title 
                        id="titleConfig"
                        text="Ajustes y Configuración del Sistema" level="H1" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader
                id="headerConfig">
                
            </f:DynamicPageHeader>
        </f:header>

        <f:content>

            <VBox id="fit" class="settingsRoot" fitContainer="true">
                <ScrollContainer id="moewqwre"
                    vertical="true"
                    horizontal="false"
                    height="100%"
                    class="settingsScroll">

                    <VBox id="morasdae" class="settingsContent">

                        <HBox id="masasore"
                            wrap="Wrap"
                            alignItems="Start"
                            class="settingsColumns">

                            <VBox id="moresada" class="settingsColumn">

                                <Panel id="morsade"
                                    headerText="Work Hours Configuration"
                                    expandable="false"
                                    class="settingsPanel">

                                    <content>
                                        <VBox id="madore" class="panelFields">

                                            <Label id="mwqwore"
                                                text="Daily Hour Limit"
                                                labelFor="dailyHourLimit"/>

                                            <HBox id="moradsfe"
                                                alignItems="Center"
                                                class="unitField">
                                                <Input
                                                    id="dailyHourLimit"
                                                    value="{settings>/dailyHourLimit}"
                                                    type="Number"
                                                    width="100%"
                                                    class="fieldInput"/>
                                                <Text id="modawsre" text="hrs" class="unitText"/>
                                            </HBox>

                                            <Label id="morasdfae"
                                                text="Weekly Overtime Threshold"
                                                labelFor="weeklyOvertime"/>
 
                                            <HBox id="morewqe"
                                                alignItems="Center"
                                                class="unitField">
                                                <Input
                                                    id="weeklyOvertime"
                                                    value="{settings>/weeklyOvertime}"
                                                    type="Number"
                                                    width="100%"
                                                    class="fieldInput"/>
                                                <Text id="movfgre" text="hrs" class="unitText"/>
                                            </HBox>

                                            <Label id="moreddd"
                                                text="Submission Threshold"
                                                labelFor="submissionThreshold"/>

                                            <HBox id="morasdase"
                                                alignItems="Center"
                                                class="unitField">
                                                <Input
                                                    id="submissionThreshold"
                                                    value="{settings>/submissionThreshold}"
                                                    type="Number"
                                                    width="100%"
                                                    class="fieldInput"/>
                                                <Text id="moreasl-kjmas" text="hours" class="unitText"/>
                                            </HBox>

                                        </VBox>
                                    </content>
                                </Panel>

                                 <Panel id="mfsdore"
                                    headerText="Alerts &amp; Notifications"
                                    expandable="false"
                                    class="settingsPanel alertsPanel">

                                    <content>
                                        <VBox id="morfse" class="notificationFields">

                                            <HBox id="morasdaswe"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                class="notificationRow">

                                                <Label id="mofsdre" text="Email Notifications"/>
                                                <Switch id="mosdre"
                                                    state="{settings>/emailNotifications}"
                                                    customTextOn="On"
                                                    customTextOff="Off"
                                                    type="Default"/>
                                            </HBox>

                                            <HBox id="morqwqe"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                class="notificationRow">

                                                <Label id="morwqeqe" text="Direct Manager Escalations"/>
                                                <Switch id="m22ore"
                                                    state="{settings>/managerEscalations}"
                                                    customTextOn="On"
                                                    customTextOff="Off"
                                                    type="Default"/>
                                            </HBox>

                                            <HBox id="morrrre"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                class="notificationRow">

                                                <Label id="morfffe" text="Weekly Summary Reports"/>
                                                <Switch id="mor22e"
                                                    state="{settings>/weeklyReports}"
                                                    customTextOn="On"
                                                    customTextOff="Off"
                                                    type="Default"/>
                                            </HBox>


                                        </VBox>
                                    </content>
                                </Panel>
                                
                        <Panel
                            id="panelPoliticasConfig"
                            headerText="Políticas de registro"
                            expandable="false"
                            class="settingsPanel">

                            <content>
                                <VBox class="panelFields">

                                    <Label
                                        text="Política de días pendientes"
                                        labelFor="pendingDaysPolicy"/>

                                    <Select
                                        id="pendingDaysPolicy"
                                        selectedKey="{settings>/pendingDaysPolicy}"
                                        width="100%">

                                        <core:Item
                                            key="BLOQUEAR"
                                            text="Bloquear registros"/>

                                        <core:Item
                                            key="ADVERTIR"
                                            text="Mostrar advertencia"/>
                                    </Select>

                                </VBox>
                            </content>
                        </Panel>
                        <Panel
                            id="panelPdfConfig"
                            headerText="Configuración de reportes PDF"
                            expandable="false"
                            class="settingsPanel">

                            <content>
                                <VBox class="panelFields">

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="SpaceBetween"
                                        class="notificationRow">

                                        <Label
                                            text="Generación automática de PDF"/>

                                        <Switch
                                            state="{settings>/automaticPdf}"
                                            type="Default"/>
                                    </HBox>

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="SpaceBetween"
                                        class="notificationRow">

                                        <Label
                                            text="Permitir regeneración de reportes"/>

                                        <Switch
                                            state="{settings>/allowRegeneration}"
                                            type="Default"/>
                                    </HBox>

                                    <Label
                                        text="Plantilla del reporte PDF"/>

                                    <Input
                                        value="{settings>/pdfTemplate}"
                                        maxLength="55"
                                        width="100%"
                                        class="fieldInput"/>

                                    <Label
                                        text="Método de firma"/>

                                    <Input
                                        value="{settings>/signatureMethod}"
                                        maxLength="55"
                                        width="100%"
                                        class="fieldInput"/>

                                </VBox>
                            </content>
                        </Panel>


                            </VBox>
                <VBox id="morepp" class="settingsColumn">

                                <Panel id="morffe"
                                    headerText="Scheduling &amp; Grace Periods"
                                    expandable="false"
                                    class="settingsPanel">

                                    <content>
                                        <VBox id="morep1p1" class="panelFields">

                                            <Label id="m121ore"
                                                text="Closing Day"
                                                labelFor="closingDay"/>

                                                                
                        <Input
                            id="closingDay"
                            value="{settings>/closingDay}"
                            type="Number"
                            width="100%"
                            placeholder="Día del mes (1-31)"
                            class="fieldInput"/>


                                            <Label id="lwo"
                                                text="Submission Deadline Grace Period"
                                                labelFor="gracePeriod"/>

                                            <HBox id="lwo1"
                                                alignItems="Center"
                                                class="unitField">
                                                <Input
                                                    id="gracePeriod"
                                                    value="{settings>/gracePeriod}"
                                                    type="Number"
                                                    width="100%"
                                                    class="fieldInput"/>
                                                <Text id="lw3o" text="days" class="unitText"/>
                                            </HBox>

                                            <Label id="lw1o"
                                                text="Approval Turnaround Limit"
                                                labelFor="approvalLimit"/>

                                            <HBox id="lw11o"
                                                alignItems="Center"
                                                class="approvalField">

                                                <Input
                                                    id="approvalLimit"
                                                    value="{settings>/approvalLimit}"
                                                    type="Number"
                                                    width="100%"
                                                    class="fieldInput"/>

                                                <Text id="lwwwwo" text="days" class="unitText"/>
                                            </HBox>

                                        </VBox>
                                    </content>
                                </Panel>

        <Panel
            id="panelNotificacionesConfig"
            headerText="Programación de notificaciones"
            expandable="false"
            class="settingsPanel">

            <content>
                <VBox class="panelFields">

                    <Label
                        text="Frecuencia de recordatorios"
                        labelFor="reminderFrequency"/>

                    <HBox
                        alignItems="Center"
                        class="unitField">

                        <Input
                            id="reminderFrequency"
                            value="{settings>/reminderFrequency}"
                            type="Number"
                            width="100%"
                            class="fieldInput"/>

                <Text
                    text="días"
                    class="unitText"/>
            </HBox>

            <Label
                text="Canal de notificación"
                labelFor="notificationChannel"/>

            <Input
                id="notificationChannel"
                value="{settings>/notificationChannel}"
                maxLength="55"
                width="100%"
                class="fieldInput"/>

                </VBox>
            </content>
        </Panel>

                            </VBox>

                        </HBox>
                    </VBox>
                </ScrollContainer>

            </VBox>
        
        </f:content>

        <f:footer>
            <OverflowToolbar
                id="footerConfigToolbar">
                <ToolbarSpacer id="spacerConfig"/>

                <Text
                    id="footerConfig"
                    class="textAcciones"
                    text="Selecciona el proceso que deseas realizar."/>
    
            <Button
                id="btnRecordatorioMasivo"
                text="Guardar"
                type="Emphasized"
                press=".onSave"
                tooltip="Guardar configuración en SAP"
                class="sapUiTinyMarginEnd"/>


                            <Button
                                id="botonCancelarConfig"
                                text="Cancelar"
                                class="btnCancelar"
                                type="Reject"
                                press=".onCancel"/>

                        
            <Button
                id="btnConsolidarReportes"
                text="Reiniciar"
                press=".onReset"
                tooltip="Restaurar valores predeterminados"
                class="sapUiTinyMarginEnd btnGuardar"/>

                        </OverflowToolbar>
                    </f:footer>
    
    </f:DynamicPage>
</mvc:View>

