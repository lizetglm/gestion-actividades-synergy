<mvc:View id="viewPerfiles"
	controllerName="ns.frontend.controller.admin.Perfiles"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout" 
	xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    busyIndicatorDelay="0"
    height="100%"
    displayBlock="true"
>
	<Page
        id="pagePerfiles"
        showHeader="false"
        backgroundDesign="Transparent"
        class="sapUiResponsiveContentPadding"
        enableScrolling="true">

    <content>
            <VBox id="idBannerProf" class="sapUiSmallMargin gapBody">
                <Breadcrumbs id="idActualDireccionProf" currentLocationText="{i18n>profTitle}">
                    <Link id="idRegresoProf" text="{i18n>title}" press=".onBack" />
                </Breadcrumbs>

                <FlexBox id="idFlexBoxProf" justifyContent="SpaceBetween" alignItems="End" >
                    <Title
                        id="idTituloProf"
                        level="H4" titleStyle="H4"
                        text="Administración de Usuarios y Perfiles"
                        wrapping="true"
                        wrappingType="Hyphenated">
                    </Title>
                    <Button 
                        id="btnConfigurationProfiles"
                        text="Configuración" 
                        icon="sap-icon://action-settings" 
                        type="Transparent"
                        press=".onSettings"    
                    />
                </FlexBox>

            <!-- Contenedor principal -->
            <HBox 
                id="mainLayoutProf" 
                justifyContent="SpaceBetween" 
                wrap="Wrap" 
                class="mainLayoutProf">
            <!-- Columna izquierda con lista de los usuarios principal -->
            <VBox id="leftColumnProf" width="29%">
                <Panel 
                    id="panelListaUsuarios" 
                    backgroundDesign="Transparent" 
                    headerText="Lista de Usuarios" 
                    accessibleRole="Region" 
                    class="borde">
                    <content>
                        <HBox
                            id="contenedorBusqueda"
                            alignItems="Center"
                            class="searchContainer">
                            <SearchField
                                id="buscadorUsuarios"
                                width="100%"
                                placeholder="Search"
                                liveChange=".onSearch"/>
                            <Button
                                id="botonFiltrarUsuarios"
                                icon="sap-icon://filter"
                                type="Transparent"
                                tooltip="Filtrar usuarios"/>
                        </HBox>

                        <ScrollContainer
                            id="scrollContainerUsuarios"
                            height="19rem"
                            vertical="true"
                            horizontal="false">
                            <List
                                id="listaUsuarios"
                                items="{users>/users}"
                                mode="SingleSelectMaster"
                                includeItemInSelection="true"
                                selectionChange=".onUserSelect"
                                class="usersList"
                                noDataText="No se encontraron usuarios">
                                <items>
                                    <CustomListItem
                                        id="plantillaUsuario"
                                        type="Active">
                                        <VBox
                                            id="contenidoUsuario"
                                            width="100%"
                                            class="userListItem">
                                            <Text
                                                id="nombreUsuarioLista"
                                                text="{users>fullName}"
                                                wrapping="true"
                                                class="userName"/>
                                            <HBox
                                                id="datosSecundariosUsuario"
                                                width="100%"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                wrap="Wrap">
                                                <Text
                                                    id="identificadorUsuarioLista"
                                                    text="{users>userId}"
                                                    wrapping="true"
                                                    class="userId"/>
                                                <ObjectStatus
                                                    id="estadoUsuarioLista"
                                                    text="{users>status}"
                                                    state="{= ${users>status} === 'Activo' ? 'Success' : 'None' }"/>
                                            </HBox>
                                        </VBox>
                                    </CustomListItem>
                                </items>
                            </List>
                        </ScrollContainer>
                    </content>
                </Panel>
            </VBox>

            <VBox id="rightColumnProf" width="69%">
                <Panel 
                    id="panelDetallesUsuarios" 
                    backgroundDesign="Solid" 
                    headerText="{= 'Detalles del Usuario: ' + (${users>/selectedUser/fullName} || '') }" 
                    class="borde">
                    <content>
                        <IconTabBar
                            id="pestanasDetallesUsuario"
                            expandable="false"
                            selectedKey="general"
                            class="detailsTabs">
                            <items>
                                <IconTabFilter
                                    id="pestanaInformacionGeneral"
                                    text="Información General"
                                    key="general">
                                    <VBox
                                        id="tarjetaInformacionGeneral"
                                        class="generalCard">
                                        <HBox
                                            id="columnasInformacionGeneral"
                                            fitContainer="true">
                                            <VBox
                                                id="columnaInformacionIzquierda"
                                                width="50%"
                                                class="fieldColumn">
                                                <Label 
                                                    id="labelNombreCompleto" 
                                                    text="Nombre Completo:"
                                                    />
                                                    <Text 
                                                        id="valorNombreCompleto" 
                                                        text="{users>/selectedUser/fullName}"/>
                                                <Label 
                                                    id="labelIdUsuario" 
                                                    text="ID de Usuario:"/>
                                                    <Text id="valorIdUsuario" 
                                                        text="{users>/selectedUser/userId}"/>
                                                <Label id="labelCorreoElectronico" text="Correo Electrónico:"/>
                                                <Text id="valorCorreoElectronico" text="{users>/selectedUser/email}"/>
                                                <Label id="labelDepartamentoIzquierdo" text="Departamento:"/>
                                                <Text id="valorDepartamentoIzquierdo" text="{users>/selectedUser/department}"/>
                                            </VBox>
                                            <VBox
                                                id="columnaInformacionDerecha"
                                                width="50%"
                                                class="fieldColumn">
                                                <Label id="labelDepartamento" text="Departamento:"/>
                                                <Text id="valorDepartamento" text="{users>/selectedUser/department}"/>
                                                <Label id="labelUbicacion" text="Ubicación:"/>
                                                <Text id="valorUbicacion" text="{users>/selectedUser/location}"/>
                                                <Label id="labelFechaCreacion" text="Fecha de Creación:"/>
                                                <Text id="valorFechaCreacion" text="{users>/selectedUser/creationDate}"/>
                                                <Label id="labelEstadoUsuario" text="Estado:"/>
                                                <ObjectStatus
                                                    id="valorEstadoUsuario"
                                                    text="{users>/selectedUser/status}"
                                                    state="{= ${users>/selectedUser/status} === 'Activo' ? 'Success' : 'None' }"/>
                                            </VBox>
                                        </HBox>
                                        <HBox
                                            id="contenedorBotonEditar"
                                            justifyContent="End"
                                            class="editButtonContainer">
                                            <Button
                                                id="botonEditarUsuario"
                                                text="Editar"
                                                press=".onEditUser"/>
                                        </HBox>
                                    </VBox>
                                </IconTabFilter>
                                <IconTabFilter
                                    id="pestanaRolesAsignados"
                                    text="Roles Asignados"
                                    key="roles">
                                    <VBox
                                        id="seccionRolesAsignados"
                                        class="rolesSection">
                                        <Toolbar
                                            id="barraAccionesRoles"
                                            class="rolesToolbar">
                                            <Button
                                                id="botonAsignarNuevoRol"
                                                text="Asignar Nuevo Rol"
                                                icon="sap-icon://add"
                                                press=".onAssignRole"/>
                                            <Button
                                                id="botonEliminarRol"
                                                text="Eliminar Rol"
                                                icon="sap-icon://delete"
                                                type="Reject"
                                                press=".onDeleteRole"/>
                                        </Toolbar>
                                        <Table
                                            id="tablaRoles"
                                            items="{users>/selectedUser/roles}"
                                            mode="SingleSelectLeft"
                                            noDataText="No hay roles asignados">
                                            <columns>
                                                <Column id="columnaNombreRol"><Text id="textRol" text="Nombre del Rol"/></Column>
                                                <Column id="columnaDescripcionRol"><Text id="textDescr" text="Descripción"/></Column>
                                                <Column id="columnaSistemaOrigen"><Text id="textSys" text="Sistema de Origen"/></Column>
                                                <Column id="columnaValidoDesde"><Text id="valTil" text="Válido Desde"/></Column>
                                                <Column id="columnaValidoHasta"><Text id="valUnt" text="Válido Hasta"/></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem id="plantillaFilaRol">
                                                    <cells>
                                                        <Text id="textName" text="{users>name}"/>
                                                        <Text id="textDesc" text="{users>description}"/>
                                                        <Text id="textSour" text="{users>source}"/>
                                                        <Text id="textVal" text="{users>validFrom}"/>
                                                        <Text id="textValTo" text="{users>validTo}"/>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </VBox>
                                </IconTabFilter>
                                <IconTabFilter id="pestanaGrupos" text="Grupos" key="groups">
                                    <VBox id="contenidoGrupos" class="emptyTabContent"/>
                                </IconTabFilter>
                                <IconTabFilter id="pestanaAutorizacionesDirectas" text="Autorizaciones Directas" key="authorizations">
                                    <VBox id="contenidoAutorizaciones" class="emptyTabContent"/>
                                </IconTabFilter>
                            </items>
                        </IconTabBar>
                    </content>
                </Panel>
            </VBox>

            </HBox>

            <!-- Barra inferior de acciones -->
            <HBox
                id="bottomActionsConso1idacion"
                class="borde bottomBar "
                alignItems="Center">

                <Text
                    id="selectedRows1Text"
                    class="textAcciones"
                    text="Selecciona el proceso que deseas realizar."/>

                <ToolbarSpacer id="spacerAc1cionesInferiores"/>

                <Button
                    id="botonGuardar"
                    text="Guardar"                  
                    type="Emphasized"
                    press=".onSave"/>
                
                <Button
                    id="botonCancelar"
                    text="Cancelar"
                    class="btnCancelar"
                    type="Reject"
                    press=".onCancel"/>
                
                <Button
                    id="botonCrearNuevoUsuario"
                    text="Crear Nuevo Usuario"
                    class="btnGuardar"
                    press=".onCreateUser"/>           
            </HBox>
        
        </VBox>        
    </content>
    </Page>
</mvc:View>