<mvc:View id="vistaRequerimientos"
    controllerName="ns.frontend.controller.admin.Requerimientos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:uxap="sap.uxap"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    
    <uxap:ObjectPageLayout id="pageDetalleProyecto" showTitleInHeaderContent="true">
        
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="Proyecto: {mock>nombreProyecto}" wrapping="true"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title text="{mock>nombreProyecto}" wrapping="true" />
                </uxap:snappedHeading>
                <uxap:actions>
                    <Button icon="sap-icon://decline" type="Transparent" press=".onCloseColumn" tooltip="Cerrar Columna" />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <layout:VerticalLayout class="sapUiSmallMarginBeginEnd">
                <ObjectStatus title="ID Proyecto" text="{mock>idProyecto}"/>
                <ObjectStatus title="Fechas" text="{mock>fechaInicio} al {mock>fechaFin}"/>
                <ObjectStatus title="Estatus" text="{mock>estatusProyecto}" state="Information"/>
            </layout:VerticalLayout>
        </uxap:headerContent>

        <uxap:sections>
            <!-- REQUERIMIENTOS -->
            <uxap:ObjectPageSection title="{i18n>tblReq}" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="tablaRequerimientos" items="{mock>requerimientos}" alternateRowColors="true">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <ToolbarSpacer />
                                        <Button icon="sap-icon://excel-attachment" tooltip="Exportar a Excel" press=".onExportarReqExcel" />
                                        <Button text="{i18n>btnNewReq}" type="Emphasized" icon="sap-icon://add" press=".onAddRequerimiento" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="10rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="ID Req." />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>description}" />
                                    </Column>
                                    <Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>actions}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{mock>idRequerimiento}" />
                                            <Text text="{mock>descripcion}" />
                                            <HBox justifyContent="End" gap="0.5rem">
                                                <Button icon="sap-icon://edit" type="Attention" tooltip="Editar" press=".onEditRequerimiento" />
                                                <Button icon="sap-icon://delete" type="Reject" tooltip="Eliminar" press=".onDeleteRequerimiento" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            
            <!-- CONSULTORES ASIGNADOS -->
            <uxap:ObjectPageSection title="{i18n>titleTableConsultores}" titleUppercase="false" class="sapUiSmallMarginTopBottom sapUiMediumMarginBottom">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="tablaConsultoresDetalle" items="{mock>consultores}" alternateRowColors="true">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <ToolbarSpacer />
                                        <Button icon="sap-icon://excel-attachment" tooltip="Exportar a Excel" press=".onExportarConsultoresExcel" />
                                        <Button text="{i18n>btnAsignarConsultor}" 
                                                type="Emphasized" 
                                                icon="sap-icon://add-employee" 
                                                press=".onAsignarConsultor" 
                                        />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>consultant}" /> 
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>rol}" /> 
                                    </Column>
                                     <Column width="100px" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>actions}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="colListItemConsultores">
                                        <cells>
                                            <Text text="{mock>nombreConsultor}" />
                                            <Text text="{mock>rol}" />
                                            <HBox justifyContent="End">
                                                <Button icon="sap-icon://decline" type="Reject" tooltip="Remover" press=".onInactivarConsultor" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>