<mvc:View id="idProyectosView"
    controllerName="ns.frontend.controller.admin.Proyectos" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:layout="sap.ui.layout" 
    xmlns:uxap="sap.uxap"
    xmlns:core="sap.ui.core" 
>
    
    <uxap:ObjectPageLayout id="idDetalleObjectPageLayout" showTitleInHeaderContent="true">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="Cliente: {Nombre}" wrapping="true"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <FlexBox fitContainer="true" alignItems="Center">
                        <Avatar src="sap-icon://factory" backgroundColor="Random" class="sapUiTinyMarginEnd"/>
                        <Title text="Cliente: {Nombre}" wrapping="true" />
                    </FlexBox>
                </uxap:snappedHeading>
                <uxap:actions>
                    <Button icon="sap-icon://decline" type="Transparent" press=".onCloseColumn" tooltip="Cerrar Columna" />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <FlexBox wrap="Wrap" alignItems="Center">
                <Avatar src="sap-icon://factory" backgroundColor="Random" displaySize="M" class="sapUiTinyMarginEnd"/>
                <layout:VerticalLayout class="sapUiSmallMarginBeginEnd ">
                    <ObjectStatus title="{i18n>estatus}" text="{= ${Activo} === 'Yes' || ${Activo} === 'Si' ? 'Activo' : 'Inactivo' }"
                    state="{= ${Activo} === 'Yes' || ${Activo} === 'Si' ? 'Success' : 'Error' }" />
                    <ObjectStatus title="{i18n>numTelefono}" text="{Telefono}"/>
					<ObjectStatus title="{i18n>email}" text="{Correo}" />
                </layout:VerticalLayout>
            </FlexBox>
        </uxap:headerContent>

        <uxap:sections>
            <uxap:ObjectPageSection title="{i18n>titleTableProyectos}" class="sapUiSmallMarginTopBottom" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="tablaProyectosDetalle" 
                                items="{
                                    path: '_Proyectos',
                                    parameters: { $select: 'FechaInicio,FechaFin' },
                                    sorter: [
                                        { path: 'Activo', descending: true },
                                        { path: 'Nombre' }
                                    ]
                                }" 
                                alternateRowColors="true"
                                class="sapUiMediumMarginBottom tablaFondoColor"
                            >
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <ToolbarSpacer />
                                        <Button icon="sap-icon://excel-attachment" tooltip="Exportar a Excel" press=".onExportarProyectosExcel"/>
                                        <Button text="Nuevo Proyecto" type="Emphasized" icon="sap-icon://add" press=".onAddProyecto" />
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>nameProject}" />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                        <Text text="{i18n>description}" />
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" width="4.5rem">
                                        <Text text="{i18n>estatus}" />
                                    </Column>
                                    <Column width="100px" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>actions}"/>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem type="Navigation" press=".onSelectProyecto"
                                        highlight="{= ${Activo} === 'Yes' ? 'Success' : 'Error' }"
                                    >
                                        <customData>
                                            <core:CustomData key="inactivo"
                                                value="{= ${Activo} === true ? 'false' : 'true' }"
                                                writeToDom="true" />
                                        </customData>
                                        <cells>
                                            <Text text="{Nombre}" />
                                            <Text text="{Descripcion}" />
                                            <ObjectStatus text="{= ${Activo} === 'Yes' ? 'Activo' : 'Inactivo' }" state="{= ${Activo} === 'Yes' ? 'Success' : 'Error' }" />
                                            <HBox justifyContent="End" gap="0.5rem">
                                                <Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press=".onEditProyecto"
                                                visible="{= ${Activo} === true ? true : false }"  />

                                                <Button icon="sap-icon://decline" type="Transparent" tooltip="Inactivar"
                                                    visible="{= ${Activo} === true ? true : false }" 
                                                    press=".onInactivarProyecto" />
                                                <Button icon="sap-icon://accept" type="Transparent" tooltip="Activar"
                                                    visible="{= ${Activo} === true ? false : true }" press=".onActivarProyecto" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>