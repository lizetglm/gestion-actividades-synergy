<mvc:View controllerName="ns.frontend.controller.admin.Clientes" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:f="sap.f" 
    xmlns:core="sap.ui.core" 
    xmlns:layout="sap.ui.layout">
    
    <f:DynamicPage id="pageClientes" class="sapUiSizeCompact">
        <f:title>
            <f:DynamicPageTitle>
                <f:breadcrumbs >
                   <Breadcrumbs currentLocationText="{i18n>appAdmin2}"
                    class="sapUiSmallMarginTopBottom">
                        <Link text="{i18n>tituloGrupo1}" press=".onBack" />
                    </Breadcrumbs>
                </f:breadcrumbs>
                <f:heading>
                    <Title text="Catálogo de Clientes" level="H1" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <layout:HorizontalLayout allowWrapping="true">
                    <layout:VerticalLayout class="sapUiMediumMarginEnd">
                        <Label text="Buscar Cliente" />
                        <SearchField id="sfCliente" placeholder="Nombre o correo..." width="300px" search=".onFiltrar" />
                    </layout:VerticalLayout>
                    <layout:VerticalLayout>
                        <Label text="Estatus" />
                        <Select id="selEstatus" width="200px" selectedKey="Todos" change=".onFiltrar">
                            <core:Item key="Todos" text="Todos" />
                            <core:Item key="Activo" text="Activos" />
                            <core:Item key="Inactivo" text="Inactivos" />
                        </Select>
                    </layout:VerticalLayout>
                </layout:HorizontalLayout>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table 
                id="tablaClientes"
                items="{
                    path: '/Clientes',
                    parameters: {$count: true},
                    sorter: [
                        { path: 'Activo', descending: true },
                        { path: 'Nombre' }
                    ]
                }"
                alternateRowColors="true"
                class="sapUiMediumMarginBottom tablaFondoColor">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Clientes" level="H2" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://excel-attachment" tooltip="Exportar a Excel" press=".onExportarExcel"/>
                        <Button text="Nuevo Cliente" type="Emphasized" icon="sap-icon://add" press=".onAddCliente" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Nombre del Cliente" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Teléfono" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Correo" />
                    </Column>
                    <Column minScreenWidth="Tablet" width="4rem" demandPopin="true" popinDisplay="Inline">
                        <Text text="Estatus" />
                    </Column>
                    <Column width="100px" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Acciones" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" 
                        press=".onSelectCliente"
                        highlight="{= ${Activo} === 'Yes' ? 'Success' : 'Error' }"
                    >
                        <customData>
                            <core:CustomData key="inactivo"
                                value="{= ${Activo} === true ? 'false' : 'true' }"
                                writeToDom="true" />
                        </customData>
                        <cells>
                            <Text text="{Nombre}" />
                            <Text text="{Telefono}" />
                            <Text text="{Correo}" />
                            <ObjectStatus text="{= ${Activo} === 'Yes' ? 'Activo' : 'Inactivo' }" state="{= ${Activo} === 'Yes' ? 'Success' : 'Error' }" />
                            <HBox justifyContent="End" gap="0.5rem">
                                <Button icon="sap-icon://edit" type="Transparent" tooltip="Editar" press=".onEditCliente" 
                                visible="{= ${Activo} === true ? true : false }" 
                                />
                                <Button icon="sap-icon://decline" type="Transparent" tooltip="Inactivar"
                                        visible="{= ${Activo} === true ? true : false }" press=".onInactivarCliente" />
                                <Button icon="sap-icon://accept" type="Transparent" tooltip="Activar"
                                        visible="{= ${Activo} === true ? false : true }" press=".onActivarCliente" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>