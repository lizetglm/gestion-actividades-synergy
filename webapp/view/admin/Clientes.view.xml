<mvc:View controllerName="ns.frontend.controller.admin.Clientes" 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:f="sap.f" 
    xmlns:core="sap.ui.core" 
    xmlns:layout="sap.ui.layout">
    
    <f:DynamicPage id="pageClientes" class="sapUiSizeCompact">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Gestión de Clientes" level="H1" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <layout:HorizontalLayout allowWrapping="true">
                    <layout:VerticalLayout class="sapUiMediumMarginEnd">
                        <Label text="Buscar Cliente" />
                        <SearchField placeholder="Nombre del cliente..." width="300px" />
                    </layout:VerticalLayout>
                    <layout:VerticalLayout>
                        <Label text="Estatus" />
                        <Select width="200px" selectedKey="Todos">
                            <core:Item key="Todos" text="Todos" />
                            <core:Item key="Activo" text="Activos" />
                            <core:Item key="Inactivo" text="Inactivos" />
                        </Select>
                    </layout:VerticalLayout>
                </layout:HorizontalLayout>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table 
                id="tablaClientes"
                items="{mock>/clientes}" 
                alternateRowColors="true"
                class="sapUiMediumMarginBottom">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Clientes" level="H2" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://excel-attachment" tooltip="Exportar a Excel" press=".onExportarExcel"/>
                        <Button text="Nuevo Cliente" type="Emphasized" icon="sap-icon://add" press=".onAddCliente" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="ID Cliente" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Nombre del Cliente" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Proyectos Asignados" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                        <Text text="Estatus" />
                    </Column>
                    <Column width="100px" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Acciones" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onSelectCliente">
                        <cells>
                            <Text text="{mock>idCliente}" />
                            <Text text="{mock>nombre}" />
                            <Text text="{mock>totalProyectos}" />
                            <ObjectStatus text="{mock>estatus}" state="{= ${mock>estatus} === 'Activo' ? 'Success' : 'Error' }" />
                            <HBox justifyContent="End" gap="0.5rem">
                                <Button icon="sap-icon://edit" type="Attention" tooltip="Editar" press=".onEditCliente" />
                                <Button icon="sap-icon://delete" type="Reject" tooltip="Inactivar" press=".onDeleteCliente" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>