<mvc:View
	controllerName="ns.frontend.controller.Second"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page
        id="idPage"
        backgroundDesign="Standard"
        enableScrolling="true"
        floatingFooter="false"
        navButtonTooltip=""
        showFooter="true"
        showHeader="true"
        title="Holaaa"
        titleAlignment="Auto"
        titleLevel="Auto"
        showNavButton="false"
        showSubHeader="true"
    >
        <content>
            <Text id="idTitleText" text="This is the content of the second view." />

            <ObjectHeader
                id="id.ObjectHeader"
                icon="sap-icon://product"
                iconDensityAware="false"
                iconAlt="{Name}"
                title="Laptop ASUS ROG"
                number="25000.00"
                numberUnit="MXN"
                class="sapUiResponsivePadding--header" >
                <statuses>
                    <ObjectStatus
                        id="idInStockObjectStatus"
                        text="In Stock"
                        state="Success" />
                </statuses>
                <ObjectAttribute text="2.5 kg" />
                <ObjectAttribute text="Laptop Gamer 14 pulgadas" /> 
            </ObjectHeader>

            <Button id="idBackButton" text="Back" press="onBackButtonPress" type="Back"></Button>
        </content>
    </Page> 
</mvc:View>