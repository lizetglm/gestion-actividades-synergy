<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form">
    
    <Dialog 
        id="dialogAsignarConsultor" 
        title="Asignar Consultor" 
        contentWidth="400px">
        
        <content>
            <form:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1">
                
                <form:content>
                    <Label text="Consultor" required="true" />
                    <!-- Se selecciona de una lista estandarizada -->
                    <Select selectedKey="{nuevoConsultor>/nombreConsultor}" forceSelection="false">
                        <core:Item key="Lizet López" text="Lizet López" />
                        <core:Item key="Jesús Rosiles" text="Jesús Rosiles" />
                        <core:Item key="Juan Pérez" text="Juan Pérez" />
                        <core:Item key="María González" text="María González" />
                        <core:Item key="Carlos Ramírez" text="Carlos Ramírez" />
                    </Select>
                    
                    <Label text="Rol en el Proyecto" required="true" />
                    <!-- ComboBox permite seleccionar de la lista o escribir uno nuevo si no existe -->
                    <ComboBox selectedKey="{nuevoConsultor>/rol}">
                        <core:Item key="Desarrollador ABAP RAP" text="Desarrollador ABAP RAP" />
                        <core:Item key="Desarrollador Fiori" text="Desarrollador Fiori" />
                        <core:Item key="Arquitecto Cloud" text="Arquitecto Cloud" />
                        <core:Item key="QA Tester" text="QA Tester" />
                    </ComboBox>
                </form:content>
            </form:SimpleForm>
        </content>
        
        <buttons>
            <Button text="Asignar" type="Emphasized" press=".onGuardarConsultorMock" />
            <Button text="Cancelar" type="Transparent" press=".onCerrarDialogConsultor" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>