<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form">
    
    <Dialog 
        id="dialogGestionarCliente" 
        title="Datos del Cliente" 
        contentWidth="450px">
        
        <content>
            <form:SimpleForm 
                editable="true"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <form:content>
                    <Label text="Nombre del Cliente" required="true" />
                    <Input value="{Nombre}" placeholder="Ej. Omega Logistics" id="inpNombre" />
                    
                    <Label text="Teléfono" />
                    <Input value="{Telefono}" placeholder="Ej. 4111234567" />

                    <Label text="Correo" />
                    <Input value="{Correo}" placeholder="correo@empresa.com" />
                    
                    <Label text="Estatus (Activo)" />
                    <Switch 
                        state="{Activo}" 
                        change=".onStateChange"
                        customTextOn="Sí" 
                        customTextOff="No"/>
                </form:content>
            </form:SimpleForm>
        </content>
        
        <buttons>
            <Button text="Guardar" type="Emphasized" press=".onGuardarCliente" />
            <Button text="Cancelar" type="Transparent" press=".onCerrarDialogCliente" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>