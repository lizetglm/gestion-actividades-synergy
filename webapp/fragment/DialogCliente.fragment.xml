<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form">
    
    <Dialog 
        id="dialogGestionarCliente" 
        title="Datos del Cliente" 
        contentWidth="450px">
        
        <content>
            <form:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1">
                
                <form:content>
                    <Label text="ID Cliente" required="true" />
                    <Input value="{modelo>idCliente}" placeholder="Ej. CLI-006" />
                    
                    <Label text="Nombre" required="true" />
                    <Input value="{modelo>nombre}" placeholder="Ej. Omega Logistics" />
                    
                    <Label text="Estatus" />
                    <Select selectedKey="{modelo>estatus}">
                        <core:Item key="Activo" text="Activo" />
                        <core:Item key="Inactivo" text="Inactivo" />
                        <core:Item key="Prospecto" text="Prospecto" />
                    </Select>
                </form:content>
            </form:SimpleForm>
        </content>
        
        <buttons>
            <Button text="Guardar" type="Emphasized" press=".onGuardarClienteMock" />
            <Button text="Cancelar" type="Transparent" press=".onCerrarDialogCliente" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>