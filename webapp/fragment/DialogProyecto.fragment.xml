<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form">
    
    <Dialog id="idProyectoDialog" 
        title="Nuevo/Editar Proyecto" 
        contentWidth="500px">    
        <content>
            <form:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <form:content>
                    <Label text="Nombre del Proyecto" required="true" />
                    <Input value="{nuevoReq>Nombre}" placeholder="Ej. Implementación SAP BTP" />
                    
                    <Label text="Descripción" required="true" />
                    <TextArea value="{nuevoReq>Descripcion}" placeholder="Detalles del proyecto..." rows="4" />

                    <Label text="Fecha Inicio" />
                    <DatePicker value="{nuevoReq>FechaInicio}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" />
                    
                    <Label text="Fecha Fin" />
                    <DatePicker value="{nuevoReq>FechaFin}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" />
                </form:content>
            </form:SimpleForm>
        </content>
        
        <buttons>
            <Button text="Guardar" type="Emphasized" press=".onGuardarProyectoMock" />
            <Button text="Cancelar" type="Transparent" press=".onCerrarDialogProyecto" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>