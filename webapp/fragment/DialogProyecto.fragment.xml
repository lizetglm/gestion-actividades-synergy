<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form"
>    
    <Dialog id="idProyectoDialog" 
        title="Nuevo/Editar Proyecto" 
        contentWidth="500px"
    >    
        <content>
            <form:SimpleForm 
                editable="true" 
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1">
                
                <form:content>
                    <Label text="ID Proyecto" required="true" />
                    <Input value="{nuevoReq>/idProyecto}" placeholder="Ej. PROJ-001" />
                    
                    <Label text="{i18n>name}" required="true" />
                    <Input value="{nuevoReq>/nombre}" placeholder="Ej. Configuración BTP" />
                    
                    <Label text="{i18n>description}" required="true" />
                    <TextArea value="{nuevoReq>/descripcion}" placeholder="Detalles del proyecto..." rows="4" />

                    <HBox wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                        <VBox width="49%">
                            <Label text="Fecha Inicio" />
                            <DatePicker value="{nuevoReq>/fechaInicio}" />
                        </VBox>
                        <VBox width="49%">
                            <Label text="Fecha Fin" />
                            <DatePicker value="{nuevoReq>/fechaFin}" />
                        </VBox>
                    </HBox>
                    

                    <Label text="{i18n>estatus}"></Label>
                    <Select selectedKey="{nuevoReq>/estatus}">
                        <core:Item key="Pendiente" text="Pendiente" />
                        <core:Item key="En Proceso" text="En Proceso" />
                        <core:Item key="Completado" text="Completado" />
                    </Select>
                </form:content>
            </form:SimpleForm>
        </content>
        
        <buttons>
            <Button text="Guardar" type="Emphasized" press=".onCerrarDialogProyecto" />
            <Button text="Cancelar" type="Transparent" press=".onCerrarDialogProyecto" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>