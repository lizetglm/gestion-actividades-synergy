<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form">
    
    <Dialog id="idProyectoDialog" 
        contentWidth="500px"
        afterClose=".onAfterCloseDialogo"
    >    
        <content>
            <form:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <form:content>
                    <Label text="Nombre del Proyecto" required="true" />
                    <Input value="{Nombre}" placeholder="Ej. Implementación SAP BTP" id="inpNombre"/>
                    
                    <Label text="Descripción" required="true" />
                    <TextArea value="{Descripcion}" placeholder="Detalles del proyecto..." rows="4" id="inpDescripcion"/>

                    <Label text="Fecha Inicio" required="true" />
                    <DatePicker value="{FechaInicio}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" id="inpFechaInicio"/>
                    
                    <Label text="Fecha Fin" required="true" />
                    <DatePicker value="{FechaFin}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" id="inpFechaFin"/>
                </form:content>
            </form:SimpleForm>
        </content>
        
        <buttons>
            <Button text="Guardar" type="Emphasized" press=".onGuardarProyecto" />
            <Button text="Cancelar" type="Transparent" press=".onCerrarDialogProyecto" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>