<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:form="sap.ui.layout.form">
    
    <Dialog 
        id="dialogNuevoReq" 
        title="Nuevo/Editar Requerimiento" 
        contentWidth="500px">
        <content>
            <form:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <form:content>
                    <Label text="Descripción del Requerimiento" required="true" />
                    <TextArea value="{nuevoReq>Descripcion}" placeholder="Detalles del requerimiento..." rows="4" />
                </form:content>
            </form:SimpleForm>
        </content>
        
        <buttons>
            <Button text="Guardar" type="Emphasized" press=".onGuardarRequerimiento" />
            <Button text="Cancelar" type="Transparent" press=".onCerrarDialogoReq" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>