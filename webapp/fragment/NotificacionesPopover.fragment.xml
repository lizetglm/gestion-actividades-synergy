<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Popover title="Notificaciones Pendientes" placement="Bottom" contentWidth="400px">
        <List items="{headerModel>/notificaciones}" noDataText="No tienes notificaciones nuevas">
            <NotificationListItem 
                title="{headerModel>titulo}" 
                description="{headerModel>descripcion}" 
                datetime="{headerModel>fecha}"
                priority="{headerModel>prioridad}" 
                close=".onCerrarNotificacion"/>
        </List>
    </Popover>
</core:FragmentDefinition>